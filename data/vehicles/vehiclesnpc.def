section ScrapYard
call ShipMaker.AddShip MadHunt 900 2000 5000
call ShipMaker.AddShipTon MadHunt 50 150 3800
call ShipMaker.AddShipBalance MadHunt (0,0,0,0)
call ShipMaker.InitAnmShip MadHunt Rudder None None None
call ShipMaker.AddShip SMosquito 300 3700 4900 8 10
call ShipMaker.AddShipTon SMosquito 25 100 1000
call ShipMaker.AddShipBalance SMosquito (0,0,0,0)
call ShipMaker.InitAnmShip SMosquito Rudder Flaps Motor None

section Normal
call ShipMaker.AddShip $name 2000 2000 5000
call ShipMaker.AddShipTon $name 20 50 2800
call ShipMaker.AddShipBalance $name (0,0,0,0)
call ShipMaker.InitAnmShip $name None None None None

section Medium
call ShipMaker.AddShip $name 3000 0 10000
call ShipMaker.AddShipTon $name 300 300 4000
call ShipMaker.AddShipBalance $name (0,0,0,0)
call ShipMaker.InitAnmShip $name None None None None

section Heavy
call ShipMaker.AddShip $name 4000 0 15000
call ShipMaker.AddShipTon $name 500 500 5000
call ShipMaker.AddShipBalance $name (0,0,0,0)
call ShipMaker.InitAnmShip $name None None None None
