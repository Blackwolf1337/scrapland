# The multiplayer menus (PCMenu.MultiPlayerMenu, NetJoinGameMenu with the server browser, the address and password
# pages, NetCreateGameMenu with the advanced options, NetDefaultContentMenu of the game) and the pages of the worlds of
# the new network (src/game/Script/MenuWorld.c, not in the original). The format is described in src/game/Script/Script.c. A pack in mods/
# with scrapc/menus/net.def replaces this file.

style blue
	Red 183
	Green 220
	Blue 255
style titlecolor
	Red 143
	Green 180
	Blue 215
	Effect Shadow
style optioncolor
	Red 183
	Green 220
	Blue 255
	Effect Shadow

# ---- the multiplayer menu during a game: $server is 1 on the server ----

section Multiplayer
if $server
	list opts
		"{Menu_ReturnToGame}"		Menu.BackToGame
		%PCMenu.MultiplayerMenu
		"{Net_Menu_Restart_Svr}"	PCMenu.MenuRestartServer
		"{Menu_Multiplayer_ShipMenu}"	ShipEdit.EnterEditShipMenu
		"{Menu_Options}"		Menu.OptionsMenu
		"{Menu_AbortGame}"		PCMenu.AbortMultiplayerGame
else
	list opts
		"{Menu_ReturnToGame}"		Menu.BackToGame
		%PCMenu.MultiplayerMenu
		"{Menu_Multiplayer_ShipMenu}"	ShipEdit.EnterEditShipMenu
		"{Menu_Options}"		Menu.OptionsMenu
		"{Menu_AbortGame}"		PCMenu.AbortMultiplayerGame
end
call Menu.VerticalMenu $id Multiplayer [opts] Menu.BackToGame YStart=%Menu.OptionMenuYStart
# the entry of the game mode is disabled when the mode has no menu
run ingame
call Menu.DrawBackOptionMenu $id

# ---- join a game: $domain is Internet, Local or IP ----

section Join
call Menu.StartNewMenu $id
item JoinButton_Internet Sprite
	Unit 1
	X 73
	Y 81
	ScaleX 163
	ScaleY 24
	W 163
	H 24
	OnAccept PCMenu.NetJoinInternetMenu
	Red 32
	Green 255
	Blue 255
if $domain == Internet
	Alpha 48
else
	Alpha 10
end
item JoinInternet Text
	Font Horatio
	Text "{Menu_Multiplayer_JoinGame_Internet}"
	X 155
	Y 92
	use blue
	CentralText 1
	OnAccept PCMenu.NetJoinInternetMenu
run tabwidth
item JoinButton_Local Sprite
	Unit 1
	X 238
	Y 81
	ScaleX 163
	ScaleY 24
	W 163
	H 24
	OnAccept PCMenu.NetJoinLocalMenu
	Red 32
	Green 255
	Blue 255
if $domain == Local
	Alpha 48
else
	Alpha 10
end
item JoinLocal Text
	Font Horatio
	Text "{Menu_Multiplayer_JoinGame_LocalNetwork}"
	X 320
	Y 92
	use blue
	CentralText 1
	OnAccept PCMenu.NetJoinLocalMenu
run tabwidth
item JoinButton_IP Sprite
	Unit 1
	X 403
	Y 81
	ScaleX 163
	ScaleY 24
	W 163
	H 24
	OnAccept PCMenu.NetJoinIPMenu
	Red 32
	Green 255
	Blue 255
if $domain == IP
	Alpha 48
else
	Alpha 10
end
item JoinIP Text
	Font Horatio
	Text "{Menu_Multiplayer_JoinGame_IP}"
	X 485
	Y 92
	use blue
	CentralText 1
	OnAccept PCMenu.NetJoinIPMenu
run tabwidth
if $domain == IP
	do ip
else
	do browser
	# a new list of servers, sorted by the last column again
	run browse
end
do content
call SScorer.SetOnCancel $id Menu.MainMenu
call SScorer.SetOnNext $id PCMenu.NetCreateGameMenu
call SScorer.SetOnPrev $id PCMenu.NetCreateGameMenu
lr JoinInternet JoinLocal
lr JoinLocal JoinIP
ud Join JoinInternet
ud Join JoinLocal
ud Join JoinIP
if $domain == Internet
	ud Join JoinInternet
	ud Refresh Back
elif $domain == Local
	ud Join JoinLocal
	ud Refresh Back
else
	ud Join JoinIP
	ud JoinIP Item1
	ud Item1 Item2
	ud Item2 Back
end
ud Back Join
# the item that had the cursor keeps it
default $current

# ---- the server browser: the functions of the old network; serverlist with the functions in $names ----

section browser
let slotfn PCMenu.BrowseLocalJoin
let backfn PCMenu.BrowserMenuBack
let refreshfn PCMenu.RefreshBrowseMenuButton
let sortfn PCMenu.BrowserColumnBack_Click
let nextfn PCMenu.BrowseLocalMenuNext
let prevfn PCMenu.BrowseLocalMenuPrevious
let slidergain PCMenu.BrowserSliderGainFocus
let sliderloose PCMenu.BrowserSliderLooseFocus
do serverlist

section serverlist
list slots
	-	$slotfn	BrowserSlot1
	-	$slotfn	BrowserSlot2
	-	$slotfn	BrowserSlot3
	-	$slotfn	BrowserSlot4
	-	$slotfn	BrowserSlot5
	-	$slotfn	BrowserSlot6
	-	$slotfn	BrowserSlot7
	-	$slotfn	BrowserSlot8
	-	$slotfn	BrowserSlot9
	-	$slotfn	BrowserSlot10
	-	$slotfn	BrowserSlot11
	-	$slotfn	BrowserSlot12
	-	$slotfn	BrowserSlot13
call Menu.VerticalMenu $id "" [slots] $backfn 88 VerticalStep=16 Font=Terminal8Fixed YStart=153
item Refresh Text
	Font Horatio
	Text "{Menu_MultiPlayer_Refresh}"
	X 320
	Y 384
	CentralText 1
	OnAccept $refreshfn
	use blue
	Effect Shadow
item BrowserColumnLine_H Sprite
	X 78
	Y 139
	Unit 1
	ScaleX 468
	ScaleY 1
	Alpha 64
# the columns: the title (the text cut by run columntext), the line right of it and the back that sorts by it
style title
	Y 128
	CentralText 1
	Red 183
	Green 220
	Blue 255
	Effect Shadow
	W 0
	H 0
style line
	Y 120
	Unit 1
	ScaleX 1
	ScaleY 240
	Alpha 64
style back
	Y 120
	Unit 1
	ScaleY 18
	Alpha 64
	OnAccept $sortfn
	H 18
item BrowserColumn_Name Text
	Font Terminal8Fixed
run columntext Menu_MultiPlayer_ServerName 28
	X 164
	use title
item BrowserColumnLine_Name Sprite
	X 252
	use line
item BrowserColumnBack_Name Sprite
	X 78
	ScaleX 173
	use back
	W 173
item BrowserColumn_Type Text
	Font Terminal8Fixed
run columntext Menu_MultiPlayer_ServerType 15
	X 297
	use title
item BrowserColumnLine_Type Sprite
	X 342
	use line
item BrowserColumnBack_Type Sprite
	X 254
	ScaleX 87
	use back
	W 87
item BrowserColumn_Players Text
	Font Terminal8Fixed
run columntext Menu_MultiPlayer_PlayersNumber 7
	X 366
	use title
item BrowserColumnLine_Players Sprite
	X 390
	use line
item BrowserColumnBack_Players Sprite
	X 344
	ScaleX 45
	use back
	W 45
item BrowserColumn_Map Text
	Font Terminal8Fixed
run columntext Menu_MultiPlayer_Map 19
	X 450
	use title
item BrowserColumnLine_Map Sprite
	X 510
	use line
item BrowserColumnBack_Map Sprite
	X 392
	ScaleX 117
	use back
	W 117
item BrowserColumn_Ping Text
	Font Terminal8Fixed
run columntext Menu_MultiPlayer_Ping 6
	X 528
	use title
item BrowserColumnLine_Ping Sprite
	X 546
	use line
item BrowserColumnBack_Ping Sprite
	X 512
	ScaleX 33
	use back
	W 33
# the arrows and the slider right of the list
style arrow
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/GenericButtons.alpha.tga
	SpriteIndex 3
	FocusSpriteIndex 4
	Highlight 1
	X 547
item BrowserUp Button arrow
	Y 120
	W 20
	H 20
	FocusPivotX -2
	FocusPivotY -2
	Complex 0
	Visible 1
	Rotate 1
	OnAccept $nextfn
	MultiPress 1
item BrowserDown Button arrow
	Y 344
	W 20
	H 20
	FocusPivotX -2
	FocusPivotY -2
	Complex 0
	Visible 1
	Rotate 1
	Mirror 1
	OnAccept $prevfn
	MultiPress 1
ud BrowserUp BrowserDown
lr BrowserSlot1 BrowserUp
lr BrowserSlot1 BrowserDown
item BrowserSlider Sprite
	X 550
	Y 136
	W 0
	H 0
	Unit 1
	ScaleX 11
	ScaleY 208
	Alpha 92
	Red 192
	Green 192
	Blue 255
item BrowserSliderArea Sprite
	X 549
	Y 136
	Unit 1
	ScaleX 13
	ScaleY 208
	W 20
	H 208
	FocusPivotX -3
	FocusPivotY 0
	Alpha 24
	OnGainFocus $slidergain
	OnLooseFocus $sliderloose
item BrowseTab Tab
call Menu.SetTabDefaults $id BrowseTab
	X 72
	Y 114
	SizeX 496
	SizeY 252
	Type 4
	Alpha 92
	Red 32
	Green 255
	Blue 255

# ---- the address of a server: address with the function of its join button in $joinfn ----

section ip
let joinfn PCMenu.MenuJoinGame
do address
set Item1 MaxInput 21

section address
list entries
	$serveraddress			!EditText
	"{Menu_Multiplayer_JoinGame}"	$joinfn
call Menu.VerticalMenu $id "" [entries] "" Font=Horatio VerticalStep=45 YStart=140
set Item1 Font Horatio
set Item1 X 156
set Item2 Y @Item1.Y+35

# ---- connecting to $address: waiting with the function of its abort button in $abortfn ----

section connecting
let abortfn PCMenu.AbortJoin
do waiting

section waiting
call Menu.StartNewMenu $id
list entries
	"{Menu_Multiplayer_JoinGame_Abort}"	$abortfn
	" "					""
call Menu.VerticalMenu $id $title [entries] $abortfn YStart=%Menu.SubMenuYStart
call Menu.DrawBackSubMenu $id

# ---- the password of the server ----

section password
call Menu.StartNewMenu $id
list entries
	$password				!EditText
	"{Menu_Multiplayer_JoinGame}"		PCMenu.JoinPassword
	"{Menu_Multiplayer_JoinGame_Abort}"	PCMenu.AbortJoin
call Menu.VerticalMenu $id $title [entries] PCMenu.AbortJoin Font=Horatio VerticalStep=45 YStart=%Menu.SubMenuYStart
set Item1 Font Horatio
set Item1 MaxInput 20
set Item1 X 80
set Item2 Y @Item1.Y+35
set Item2 X 220
set Item3 Y @Item1.Y+35
set Item3 X 460
lr Item2 Item3
lr Item3 Item2
call Menu.DrawBackSubMenu $id

# ---- the part the create and join pages share: $tab is Create or Join, $motd and its place; the pages of the worlds
# ($world not empty) have their own tabs and no garage ----

section content
if $world
	do worldcontent
else
	do netcontent
end

section netcontent
item Back Text
	Font ScrapBig
	Text "{Menu_Back}"
	X 320
	Y %Menu.BackButtonYStart
	CentralText 1
	OnAccept Menu.MainMenu
	use blue
	Effect Shadow
item Garaje Text
	Font ScrapMedium
	Text "{Menu_Multiplayer_ShipMenu}"
	X 504
	Y 47
	CentralText 1
	OnAccept ShipEdit.EnterEditShipMenu
	use blue
	Effect Shadow
item GarajeButtonTab Tab
call Menu.SetTabDefaults $id GarajeButtonTab
	X 432
	Y 32
	SizeX 150
	SizeY 36
	TabInit 0
	TabEnd 0
	TabMax 0
	SizeTabQuad 0
	Type 0
	Alpha 128
	Red 255
	Green 241
	Blue 174
default Back
list tabs
	Create	PCMenu.NetCreateGameMenu	"{Menu_Multiplayer_CreateGame}"
	Join	PCMenu.NetJoinGameMenu		"{Menu_Multiplayer_JoinGame}"
call Menu.AddTabs $id [tabs] $tab ParamTabSize=26 Hint=0
lr Join Garaje
lr Garaje Create
default $tab
# the message of the day from the master server
item MOTD Text
	Text $motd
	X $motdx
	Y $motdy
	Font HoratioSmall
	Effect Shadow
	Align Left
	use blue
	Alpha 255
	Visible 1
call Menu.DrawCircuitMenu $id
# the worlds of the new network (not in the original), from the main menu
if %Init.inMainMenu
	item FreeRoam Text
		Font ScrapMedium
		Text "{MP_FreeRoam}"
		X 120
		Y %Menu.BackButtonYStart+12
		CentralText 1
		OnAccept !WorldMenu
		use blue
		Effect Shadow
	lr FreeRoam Back
end

# ---- create a game: $servername, $players, $fraglimit and $advanced come from the menu function ----

section Create
call Menu.StartNewMenu $id
# the server name
item ServerNameTitle Text
	Font Horatio
	Text "{Menu_MultiPlayer_ServerName}:"
	X 74
	Y 80
	use titlecolor
measure w Horatio "{Menu_MultiPlayer_ServerName}:"
let x 74 $w 10
item ServerName Text
	Font Horatio
	Text $servername
	X $x
	Y 80
	OnAccept !EditText
	MaxInput 18
	use optioncolor
	OnGainFocus PCMenu.ServerNameGainFocus
	OnLooseFocus PCMenu.ServerNameLooseFocus
	OnRender ""
# the game mode with its arrows and the help button
item ServerTypeTitle Text
	Font Horatio
	Text "{Menu_MultiPlayer_ServerType}:"
	X 74
	Y 116
	use titlecolor
measure w Horatio "{Menu_MultiPlayer_ServerType}:"
let x 74 $w 10
item ServerType Text
	Font Horatio
	Text "{Net_Type_TeamFlag}"
	X $x+140
	Y 128
	Align Center
	use optioncolor
call Menu.PreviousNextMenuSimple 0 ServerType $x 128 280
set ServerTypePrev OnAccept PCMenu.ServerTypePrev
set ServerTypeNext OnAccept PCMenu.ServerTypeNext
item ServerTypeInfoDummy Text
	X $x+32
	Y 114
	W 216
	H 28
	OnAccept PCMenu.ServerTypeInfo
item ServerTypeInfo Text
	Font ScrapMedium
	Text i
	X $x+306
	Y 115
	W 25
	H 25
	Center 1
	Visible 1
	Effect Outline
	FocusPivotX -10
	FocusPivotY 1
	Red 165
	Green 192
	Blue 255
	OnAccept PCMenu.ServerTypeInfo
item ServerTypeInfoBack Sprite
	IsMultiSprite 1
	HighRes 1
	File 2D/ShipEditor/Buttons.alpha.tga
	SpriteIndex 1
	X $x+291
	Y 112
# the number of players and the limit of the mode (its title comes from run servertype)
item PlayersNumberTitle Text
	Font Horatio
	Text "{Menu_MultiPlayer_PlayersNumber}:"
	X 74
	Y 152
	use titlecolor
measure w Horatio "{Menu_MultiPlayer_PlayersNumber}:"
let x 74 $w 10
item PlayersNumber Text
	IsNumeric 1
	Font Horatio
	Text $players
	X $x
	Y 152
	OnAccept !EditText
	MaxInput 2
	use optioncolor
	OnGainFocus PCMenu.PlayersNumberGainFocus
	OnLooseFocus PCMenu.PlayersNumberLooseFocus
	OnRender ""
measure w Horatio $players
let x $x $w 40
item FragLimitTitle Text
	Font Horatio
	Text -:
	X $x
	Y 152
	use titlecolor
measure w Horatio -:
let x $x $w 10
item FragLimit Text
	IsNumeric 1
	Font Horatio
	Text $fraglimit
	X $x
	Y 152
	OnAccept !EditText
	MaxInput 2
	use optioncolor
	OnGainFocus PCMenu.FragLimitGainFocus
	OnLooseFocus PCMenu.FragLimitLooseFocus
	OnRender ""
# the maps of the mode: nine lines (run mapslots), the arrows and the slider
run mapslots
style arrow
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/GenericButtons.alpha.tga
	SpriteIndex 3
	FocusSpriteIndex 4
	Highlight 1
	X 316
item MapUp Button arrow
	Y 198
	W 20
	H 20
	FocusPivotX -2
	FocusPivotY -2
	Complex 0
	Visible 1
	Rotate 1
	OnAccept PCMenu.MapDown
	MultiPress 1
item MapDown Button arrow
	Y 338
	W 20
	H 20
	FocusPivotX -2
	FocusPivotY -2
	Complex 0
	Visible 1
	Rotate 1
	Mirror 1
	OnAccept PCMenu.MapUp
	MultiPress 1
lr MapSlot1 MapDown
lr MapSlot1 MapUp
ud FragLimit MapUp
ud MapUp MapDown
ud MapDown CreateButton
item MapSlider Sprite
	X 319
	Y 214
	W 0
	H 0
	Unit 1
	ScaleX 11
	ScaleY 124
	Alpha 92
	Red 192
	Green 192
	Blue 255
item MapSliderArea Sprite
	X 318
	Y 214
	Unit 1
	ScaleX 13
	ScaleY 124
	W 20
	H 124
	FocusPivotX -3
	FocusPivotY 0
	Alpha 24
	OnGainFocus PCMenu.MapSliderGainFocus
	OnLooseFocus PCMenu.MapSliderLooseFocus
item MapColumn_Line Sprite
	X 314
	Y 200
	Unit 1
	ScaleX 1
	ScaleY 152
	Alpha 64
item MapListTab Tab
call Menu.SetTabDefaults $id MapListTab
	X 72
	Y 192
	SizeX 266
	SizeY 168
	Type 4
	Alpha 32
	Red 32
	Green 255
	Blue 255
# the preview of the map that has the focus (one picture per map, run mappreviews)
item MapPreviewTab Tab
call Menu.SetTabDefaults $id MapPreviewTab
	X 344
	Y 192
	SizeX 224
	SizeY 168
	Type 4
	Alpha 1
	Red 32
	Green 255
	Blue 255
run mappreviews 344 192
item CreateButton Text
	Font Horatio
	Text "{Menu_Multiplayer_CreateGame}"
	X 320
	Y 384
	CentralText 1
	OnAccept PCMenu.MenuInitServer
	use optioncolor
item AdvancedButton Text
	Font Horatio
	Text $advanced
	Y 384
	CentralText 1
	X 100
	OnAccept PCMenu.AdvancedServer
	use optioncolor
# the mode, its limit and its maps
run servertype
do content
ud Create ServerName
lr ServerTypeNext ServerTypeInfo
ud ServerName ServerTypeInfo
ud ServerTypeInfo FragLimit
ud ServerName ServerTypeNext
ud ServerName ServerTypePrev
lr ServerTypePrev ServerTypeNext
ud ServerTypePrev PlayersNumber
ud ServerTypeNext FragLimit
lr PlayersNumber FragLimit
ud FragLimit MapSlot1
ud PlayersNumber MapSlot1
ud CreateButton Back
ud Back Create
lr AdvancedButton CreateButton
lr CreateButton AdvancedButton
call SScorer.SetOnNext $id PCMenu.NetJoinGameMenu
call SScorer.SetOnPrev $id PCMenu.NetJoinGameMenu
call SScorer.SetOnCancel $id Menu.MainMenu
default Create

# ---- the advanced server options: the texts and $usepass come from the menu function ----

section Advanced
call Menu.StartNewMenu $id
list entries
	$pass		PCMenu.SwitchUsePass
	$password	!EditText
	$force		PCMenu.SwitchForceVehicle
	$datarate	PCMenu.SetDataRate
	"{Menu_Back}"	PCMenu.BackToCreateServer
call Menu.VerticalMenu $id $title [entries] PCMenu.BackToCreateServer Font=Horatio VerticalStep=45 YStart=%Menu.SubMenuYStart
set Item1 X 100
set Item2 Font Horatio
set Item2 MaxInput 20
set Item2 X 220
set Item2 Y @Item1.Y
ud Item1 Item3
if $usepass
	lr Item1 Item2
	lr Item2 Item1
else
	set Item2 Visible 0
end
ud Join JoinInternet
set Item3 Y @Item1.Y+32
set Item3 X 100
set Item4 Y @Item3.Y+35
set Item4 X 100
set Item5 Y @Item4.Y+35
call Menu.DrawBackSubMenu $id

# ---- the worlds of the new network (src/game/Script/MenuWorld.c, not in the original): $world is Lan, List or Address
# on the join page, Host on the host page; $tab WorldJoin or WorldHost, $motd the status line, $name the player's name
# (PlayerName of the garage), $worldaddress the address of the address page ----

section World
call Menu.StartNewMenu $id
style worldtab
	Unit 1
	Y 81
	ScaleX 163
	ScaleY 24
	W 163
	H 24
	Red 32
	Green 255
	Blue 255
	Alpha 10
style worldtabtext
	Font Horatio
	Y 92
	Red 183
	Green 220
	Blue 255
	CentralText 1
item WorldButton_Lan Sprite worldtab
	X 73
	OnAccept !WorldLanMenu
item WorldLan Text
	Text "{Menu_Multiplayer_JoinGame_LocalNetwork}"
	X 155
	use worldtabtext
	OnAccept !WorldLanMenu
run tabwidth
item WorldButton_List Sprite worldtab
	X 238
	OnAccept !WorldListMenu
item WorldList Text
	Text "{MP_ListServer}"
	X 320
	use worldtabtext
	OnAccept !WorldListMenu
run tabwidth
item WorldButton_Address Sprite worldtab
	X 403
	OnAccept !WorldAddressMenu
item WorldAddress Text
	Text "{Menu_Multiplayer_JoinGame_IP}"
	X 485
	use worldtabtext
	OnAccept !WorldAddressMenu
run tabwidth
set WorldButton_$(world) Alpha 48
if $world == Address
	let serveraddress $worldaddress
	let joinfn !WorldJoinAddress
	do address
	set Item1 MaxInput 46
else
	let slotfn !WorldJoinSlot
	let backfn PCMenu.MultiPlayerMenu
	let refreshfn !WorldRefresh
	let sortfn !WorldSort
	let nextfn !WorldNext
	let prevfn !WorldPrev
	let slidergain ""
	let sliderloose ""
	do serverlist
end
do content
call SScorer.SetOnCancel $id PCMenu.MultiPlayerMenu
call SScorer.SetOnNext $id !WorldHostMenu
call SScorer.SetOnPrev $id !WorldHostMenu
lr WorldLan WorldList
lr WorldList WorldAddress
ud WorldJoin WorldLan
ud WorldJoin WorldList
ud WorldJoin WorldAddress
if $world == Address
	ud WorldJoin WorldAddress
	ud WorldAddress Item1
	ud Item1 Item2
	ud Item2 Back
else
	ud WorldJoin World$(world)
	ud Refresh Back
end
ud Back WorldJoin
default $current

# ---- the part the pages of the worlds share: the tabs, Back, the player's name, the status line ----

section worldcontent
item Back Text
	Font ScrapBig
	Text "{Menu_Back}"
	X 320
	Y %Menu.BackButtonYStart
	CentralText 1
	OnAccept PCMenu.MultiPlayerMenu
	use blue
	Effect Shadow
item WorldNameTitle Text
	Font Horatio
	Text "{MP_Name}:"
	X 432
	Y 36
	use titlecolor
measure w Horatio "{MP_Name}:"
let x 432 $w 8
item WorldName Text
	Font Horatio
	Text $name
	X $x
	Y 36
	OnAccept !EditText
	MaxInput 16
	use optioncolor
default Back
list tabs
	WorldJoin	!WorldJoinMenu	"{MP_JoinWorld}"
	WorldHost	!WorldHostMenu	"{MP_HostWorld}"
call Menu.AddTabs $id [tabs] $tab ParamTabSize=26 Hint=0
lr WorldHost WorldName
lr WorldName WorldJoin
default $tab
item MOTD Text
	Text $motd
	X $motdx
	Y $motdy
	Font HoratioSmall
	Effect Shadow
	Align Left
	use blue
	Alpha 255
	Visible 1
call Menu.DrawCircuitMenu $id

# ---- host a world: $level, $mode, $pvp and $public are the texts of the choices, $players and $port numbers ----

section WorldHost
call Menu.StartNewMenu $id
style hosttitle
	Font Horatio
	X 74
	Red 143
	Green 180
	Blue 215
	Effect Shadow
style hostvalue
	Font Horatio
	X 380
	Align Center
	Red 183
	Green 220
	Blue 255
	Effect Shadow
item HostLevelTitle Text hosttitle
	Text "{MP_Level}:"
	Y 84
item HostLevel Text
	Text $level
	use hostvalue
	Y 96
	OnAccept !WorldHostLevelNext
call Menu.PreviousNextMenuSimple 0 HostLevel 240 96 280
set HostLevelPrev OnAccept !WorldHostLevelPrev
set HostLevelNext OnAccept !WorldHostLevelNext
item HostModeTitle Text hosttitle
	Text "{MP_Mode}:"
	Y 124
item HostMode Text
	Text $mode
	use hostvalue
	Y 136
	OnAccept !WorldHostMode
call Menu.PreviousNextMenuSimple 0 HostMode 240 136 280
set HostModePrev OnAccept !WorldHostMode
set HostModeNext OnAccept !WorldHostMode
item HostPvPTitle Text hosttitle
	Text "{MP_PvP}:"
	Y 164
item HostPvP Text
	Text $pvp
	use hostvalue
	Y 176
	OnAccept !WorldHostPvP
call Menu.PreviousNextMenuSimple 0 HostPvP 240 176 280
set HostPvPPrev OnAccept !WorldHostPvP
set HostPvPNext OnAccept !WorldHostPvP
item HostPublicTitle Text hosttitle
	Text "{MP_Public}:"
	Y 204
item HostPublic Text
	Text $public
	use hostvalue
	Y 216
	OnAccept !WorldHostPublic
call Menu.PreviousNextMenuSimple 0 HostPublic 240 216 280
set HostPublicPrev OnAccept !WorldHostPublic
set HostPublicNext OnAccept !WorldHostPublic
item HostPlayersTitle Text hosttitle
	Text "{MP_MaxPlayers}:"
	Y 244
item HostPlayers Text
	IsNumeric 1
	Font Horatio
	Text $players
	X 360
	Y 244
	OnAccept !EditText
	MaxInput 2
	use optioncolor
item HostPortTitle Text hosttitle
	Text "{MP_Port}:"
	Y 284
item HostPort Text
	IsNumeric 1
	Font Horatio
	Text $port
	X 360
	Y 284
	OnAccept !EditText
	MaxInput 5
	use optioncolor
item HostButton Text
	Font Horatio
	Text "{MP_HostButton}"
	X 320
	Y 384
	CentralText 1
	OnAccept !WorldHost
	use optioncolor
do content
ud WorldHost HostLevelPrev
ud WorldHost HostLevelNext
lr HostLevelPrev HostLevelNext
ud HostLevelPrev HostModePrev
ud HostLevelNext HostModeNext
lr HostModePrev HostModeNext
ud HostModePrev HostPvPPrev
ud HostModeNext HostPvPNext
lr HostPvPPrev HostPvPNext
ud HostPvPPrev HostPublicPrev
ud HostPvPNext HostPublicNext
lr HostPublicPrev HostPublicNext
ud HostPublicPrev HostPlayers
ud HostPublicNext HostPlayers
ud HostPlayers HostPort
ud HostPort HostButton
ud HostButton Back
ud Back WorldHost
call SScorer.SetOnCancel $id PCMenu.MultiPlayerMenu
call SScorer.SetOnNext $id !WorldJoinMenu
call SScorer.SetOnPrev $id !WorldJoinMenu
default WorldHost

# ---- waiting for the world: $title, abort with !WorldAbort ----

section worldwait
let abortfn !WorldAbort
do waiting
