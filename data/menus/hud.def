# The HUD (the Scorer and CharScorer modules of the game): status, police meter, monitor, messages, talk, mission
# scorer, radar and the special action of a character. The C functions in src/game/Script/MenuHud.c give the
# margins of the screen as $mh, $mv, $right (640 - $mh) and $bottom (480 - $mv) and pick a section. The format is
# described in src/game/Script/Script.c. A pack in mods/ with scrapc/menus/hud.def replaces this file.

# ---- the status at the top right: life, lives, money, hull, boost; $char (on foot), $multi (garage or network),
# $split (split screen) ----

section status
item Status Status
if $multi
	X $right
elif $split
	X $right
else
	X $right-16
end
if $id == 1
	Y $mv+246
else
	Y $mv+6
end
	Sprite 2D/HUD/HUD.alpha.tga
	BackOffX -84
	BackOffY 0
	BackIndex 2
if $char
		LifeIconIndex 17
		LifeIconOffX -44
		LifeIconOffY 14
else
		LifeIconIndex 14
		LifeIconOffX -46
		LifeIconOffY 20
end
	LifeTextOffX -58
	LifeTextOffY 66
	LifeFont BigNumbers
	LifeTextRed 232
	LifeTextGreen 99
	LifeTextBlue 255
	LifeTextAlpha 255
	FontBackIndex 26
	FontBackOffX -61
	FontBackOffY 65
	LivesBackIndex 25
	LivesBackOffX -10.5
	LivesBackOffY 6
	LivesTextOffX -6
	LivesTextOffY -10
	LivesFont Horatio
	LivesTextRed 251
	LivesTextGreen 188
	LivesTextBlue 239
	LivesTextAlpha 255
if $multi == 0
	if $split == 0
		MoneyIconOffX -85
		MoneyIconOffY 8
		MoneyIconIndex 15
		MoneyTextOffX -86
		MoneyTextOffY 8
		MoneyFont Horatio
		MoneyTextRed 143
		MoneyTextGreen 255
		MoneyTextBlue 82
		MoneyTextAlpha 255
		MoneyBackIndex 25
		MoneyBackOffX -80.5
		MoneyBackOffY 24
	end
end
if $char == 0
		HullIconOffX -54
		HullIconOffY 13
		HullIconIndex 13
		BoostIconIndex 18
		BoostTurboIndex 19
		BoostOnRender !BoostScorer
	if $multi
		SpriteFlag 2D/HUD/FlagColor.alpha.tga
		FlagOffX -129
		FlagOffY 12
	elif $split
		SpriteFlag 2D/HUD/FlagColor.alpha.tga
		FlagOffX -129
		FlagOffY 12
	end
end

# ---- the police meter at the bottom left ----

section copmeter
item CopMeter CopMeter
	X $mh+102
	Y $bottom-67
	Sprite 2D/HUD/CopMeter.alpha.tga
	BackOffX 0
	BackOffY 0
	BackIndex 1
	BarOffX 2.5
	BarOffY 1.5
	BarIndex 2
	LightOffX 30
	LightOffY -6
	LightIndex 3

# ---- the monitor at the bottom right; in a ship with the weapons and upgrades: $char ----

section monitor
item Monitor Monitor
	X $right-121
	Y $bottom-99
	TargetView 1
	PanelSprite 2D/Monitor/Monitor.alpha.tga
	PanelIndex 1
	FrameSprite 2D/Monitor/Monitor.alpha.tga
	FrameIndex 2
	MaskSprite 2D/Monitor/Monitor.alpha.tga
	MaskIndex 3
	StaticSprite 2D/Monitor/Monitor.alpha.tga
	StaticIndex 4
	ObjetiveSprite 2D/Monitor/Monitor.alpha.tga
	ObjetiveIndex 5
	ObjetiveChargeIndex 6
	ObjetiveWhiteIndex 7
	ObjetiveBlackIndex 8
	CanPossessIndex 8
	CanPossessGlowIndex 9
	NoiseSprite 2D/Noise.tga
if $char == 0
		WeaponOffX 82
		WeaponOffY 6
		WeaponSprite 2D/HUD/WeaponIcons3D.alpha.tga
		WeaponIconScale 0.65
		WeaponIconAc 6
		WeaponIconIndex 0
		WeaponIconAc 0
		WeaponIconIndex 1
		WeaponIconAc 3
		WeaponIconIndex 4
		WeaponIconAc 2
		WeaponIconIndex 7
		WeaponIconAc 4
		WeaponIconIndex 10
		WeaponIconAc 1
		WeaponIconIndex 13
		WeaponIconAc 5
		WeaponIconIndex 16
		UpgradeIconAc 0
		UpgradeIconIndex 0
		UpgradeIconAc 1
		UpgradeIconIndex 2
		UpgradeIconAc 2
		UpgradeIconIndex 3
		UpgradeIconAc 7
		UpgradeIconIndex 5
		UpgradeIconAc 8
		UpgradeIconIndex 6
		UpgradeIconAc 5
		UpgradeIconIndex 9
		UpgradeIconAc 6
		UpgradeIconIndex 8
		UpgradeIconAc 9
		UpgradeIconIndex 11
		UpgradeIconAc 10
		UpgradeIconIndex 12
		UpgradeIconAc 3
		UpgradeIconIndex 14
		UpgradeIconAc 4
		UpgradeIconIndex 15
		UpgradeIconAc 11
		UpgradeIconIndex 17
		UpgradeIconAc 12
		UpgradeIconIndex 18
end

# ---- the messages, and outside split screen the label, the talk and the mission scorer: $splitnow (the engine
# variable SplitScreen now), $enabled ----

section msg
item Msg Msg
	X 320
	Y $mv+33
if $splitnow == 1
	if $id == 0
		Y $mv+33
	else
		Y $mv+273
	end
else
	do label
end

section label
item Label Label
	X $mh+5
	Y 286
	Red 183
	Green 220
	Blue 255
	TabBlendingMode 6
	TabSprite 2D/Menu/Tabs.alpha.tga
	TabSpriteIndex 1
	TabAlpha 128
	TabRed 100
	TabGreen 140
	TabBlue 203
call Scrap.Set MaxTalkLineSizePix 225
item Talk Talk
	X 320
	Y $bottom-12
	Sprite 2D/HUD/Talk.alpha.tga
	UseIndex 1
	NextBackIndex 2
	NextIndex 3
	TabVisible 1
	TabBlendingMode 6
	TabSprite 2D/Menu/Tabs.alpha.tga
	TabSpriteIndex 1
	TabAlpha 192
	TabRed 100
	TabGreen 140
	TabBlue 203
do mission

# ---- the mission scorer at the left; $enabled shows it when a status is on ----

section mission
item Mission Mission
	X $mh
	Y 230
	W 95
	H 101
	IsMultiSprite 1
	HighRes 1
	File 2D/HUD/Mission.alpha.tga
	BackIndex 1
	PrimaryIndex 2
	SecondaryIndex 3
	Visible 0
	TextRed 183
	TextGreen 220
	TextBlue 255
	TabBlendingMode 6
	TabSprite 2D/Menu/Tabs.alpha.tga
	TabSpriteIndex 1
	TabAlpha 192
	TabRed 100
	TabGreen 140
	TabBlue 203
if $enabled
	run missionvisible
end

# ---- the radar at the bottom left ----

section radar
item Radar Radar
