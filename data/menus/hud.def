	MaskSprite 2D/Radar/Radar.alpha.tga
	MaskIndex 2
	NoiseSprite 2D/Noise.tga
	IconsSprite 2D/Radar/Icons.alpha.tga
	IconAc 0
	IconIndex 18
	IconAc 1
	IconIndex 15
	IconAc 2
	IconIndex 26
	IconAc 3
	IconIndex 29
	IconAc 4
	IconIndex 7
	IconAc 5
	IconIndex 23
	IconAc 6
	IconIndex 37
	IconAc 7
	IconIndex 39
	IconAc 8
	IconIndex 4
	IconAc 9
	IconIndex 40
	IconAc 10
	IconIndex 41
	IconAc 11
	IconIndex 42
	IconAc 12
	IconIndex 36
	IconAc 13
	IconIndex 37
	IconAc 14
	IconIndex 38
	IconAc 15
	IconIndex 16
	IconAc 16
	IconIndex 27
	IconAc 18
	IconIndex 35
	IconAc 19
	IconIndex 30
	IconAc 20
	IconIndex 28
	IconAc 21
	IconIndex 31
	IconAc 22
	IconIndex 43

# ---- the radar of the character: $outdoor ----

section charradar
call Scorer.CreateRadarScorer $id
if $outdoor
	set Radar Map2dScale 100.0
else
	set Radar Map2dScale 40.0
end
set Radar Map2dScaleFactor 0.01
set Radar OutAlphaFactor 25

# ---- the special action of the character the player controls (top left): $act (its ActCtrl) ----

section specialaction
item SpecialAction SpecialAction
	X $mh
	Y $mv+6
	W 64
	H 64
	Visible 1
	Sprite 2D/HUD/HUD.alpha.tga
	BackOffX 0
	BackOffY 0
	BackIndex 1
	EnergyBackIndex 26
	EnergyBackOffX 36
	EnergyBackOffY 67
	EnergyBarOffX 61.5
	EnergyBarOffY 37
	EnergyBarIndex 6
	BatteryBarIndex 16
	BatteryBarOffX 56
	BatteryBarOffY 74
	CannonSprite 2D/HUD/Cannon.alpha.tga
	CannonIndex 7
	CrossHairIndex 2
	TextOffX 76
	TextOffY 8
	TextFont Horatio
	TextColorRed 251
	TextColorGreen 241
	TextColorBlue 174
	TextColorAlpha 255
	IconSprite1 2D/HUD/SpecialActions1.alpha.tga
	IconSprite2 2D/HUD/SpecialActions2.alpha.tga
	IconOffX 12
	IconOffY 18
	IconIndexSprite0 19
	InactiveColorRed 255
	InactiveColorGreen 64
	InactiveColorBlue 64
	InactiveColorAlpha 222
	ActiveColorRed 255
	ActiveColorGreen 255
	ActiveColorBlue 255
	ActiveColorAlpha 255
	GlowColorRed 244
	GlowColorGreen 255
	GlowColorBlue 75
	GlowColorAlpha 255
if $act == Dtritus
		CharAction 0
		IconIndex 8
		GlowIconIndex 9
elif $act == BankDirector
		CharAction 1
		IconIndex 11
		GlowIconIndex 0
elif $act == Police
		CharAction 2
		IconIndex 18
		GlowIconIndex 0
elif $act == Gear
		CharAction 3
		IconIndex 19
		GlowIconIndex 20
		CannonIndex 8
elif $act == Sentinel
		CharAction 4
		IconIndex 4
		GlowIconIndex 5
elif $act == Nurse
		CharAction 5
		IconIndex 1
		GlowIconIndex 0
elif $act == Desktop
		CharAction 6
		IconIndex 2
		GlowIconIndex 0
elif $act == Mayor
		CharAction 7
		IconIndex 3
		GlowIconIndex 0
elif $act == Berto
		CharAction 8
		IconIndex 14
		GlowIconIndex 15
elif $act == Functionary
		CharAction 9
		IconIndex 16
		GlowIconIndex 17
elif $act == Betty
		CharAction 10
		IconIndex 10
		GlowIconIndex 0
elif $act == Bishop
		CharAction 11
		IconIndex 6
		GlowIconIndex 0
		CannonIndex 11
elif $act == Messenger
		CharAction 12
		IconIndex 7
		GlowIconIndex 0
		CannonIndex 7
elif $act == PoliceBoss
		CharAction 13
		IconIndex 12
		GlowIconIndex 0
elif $act == BankMaster
		CharAction 14
		IconIndex 13
		GlowIconIndex 0
end

# ---- the defaults of a bar of a mission: $name, $x, $y, the colours $back, $main, $black as (red, green, blue,
# alpha) given as $backr ... $blacka ----

section missionbar
set $name IsMultiSprite 1
set $name File 2D/Racer/racer.alpha.tga
set $name X $x
set $name Y $y
set $name BackIndex 34
set $name BackRed $backr
set $name BackGreen $backg
set $name BackBlue $backb
set $name BackAlpha $backa
set $name MainBarIndex 32
set $name MainRed $mainr
set $name MainGreen $maing
set $name MainBlue $mainb
set $name MainAlpha $maina
set $name BlackBarIndex 32
set $name BlackRed $blackr
set $name BlackGreen $blackg
set $name BlackBlue $blackb
set $name BlackAlpha $blacka
