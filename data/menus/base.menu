# The building blocks of all menus (the Menu module of the game): logos, circuit, title bar, cursor, question,
# text box, tabs, slider and arrows. The C functions in src/game/Script/MenuBase.c pick a section and give the
# numbers they compute as $names. The format is described in src/game/Script/Script.c. A pack in mods/ with
# scrapc/menus/base.menu replaces this file.

style blue
	Red 183
	Green 220
	Blue 255
style arrow
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/GenericButtons.alpha.tga
	SpriteIndex 3
	FocusSpriteIndex 4
	Highlight 1
style arrowback
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/GenericButtons.alpha.tga
	SpriteIndex 1

# ---- the logos behind a menu ----

menu backmain
item LogoMainMenu ScraplandMainMenu
	X 320
	Y 0
	HighRes 1
	FileLogo 2D/Menu/LogoMainMenu.alpha.tga
	FileGlow 2D/Menu/LogoMainMenuGlow.tga
	FileNeon 2D/Menu/LogoMainMenuNeon.tga
	FileLighting 2D/Menu/LogoMainMenuLighting.tga

menu backsub
item LogoSubMenu ScraplandSubMenu
	Scale 1
	HighRes 1
	FileLogo 2D/Menu/LogoSubMenu.alpha.tga
	FileGlow 2D/Menu/LogoSubMenuGlow.tga
	FileLighting 2D/Menu/LogoSubMenuLighting.tga
	FileRingMask 2D/Menu/LogoSubMenuMask.alpha.tga
	FileRingBorder 2D/Menu/LogoSubMenuRingBorder.alpha.tga
	FileRingReflection 2D/Menu/LogoReflection.tga
	X 320
	Y 102

menu backoption
item LogoOptionMenu ScraplandSubMenu
	Scale 0.68
	HighRes 1
	FileLogo 2D/Menu/LogoSubMenu.alpha.tga
	FileGlow 2D/Menu/LogoSubMenuGlow.tga
	FileLighting 2D/Menu/LogoSubMenuLighting.tga
	FileRingMask 2D/Menu/LogoSubMenuMask.alpha.tga
	FileRingBorder 2D/Menu/LogoSubMenuRingBorder.alpha.tga
	FileRingReflection 2D/Menu/LogoReflection.tga
	X 320
	Y 81.52

# ---- the circuit, the version and in a game the dark background: $mainmenu (main menu or garage, not Xbox),
# $demo, $version, $copyright, $back (the background), the places $left, $right, $bottom, $bottom2 ----

menu circuit
style small
	Font HoratioSmall
	Effect Shadow
if $mainmenu
	if $demo
		item Copyright1 Text
			Text www.scrapland.com
			X $right
			Y $bottom
			use small
			Align Right
			use blue
			Alpha 255
			Visible 1
		item Webpage Text
			Text "Published by Enlight Software Ltd."
			X $left
			Y $bottom2
			use small
			Align Left
			use blue
			Alpha 255
			Visible 1
		item Copyright2 Text
			Text $copyright
			X $left
			Y $bottom
			use small
			Align Left
			use blue
			Alpha 255
			Visible 1
		item VersionText Text
			Text "Demo Version"
			X $right
			Y $bottom2
			use small
			Align Right
			use blue
			Alpha 255
			Visible 1
	else
		item VersionText Text
			Text $version
			X $right
			Y $bottom
			use small
			Align Right
			use blue
			Alpha 255
			Visible 1
	end
end
item Circuit Circuit
	BlendingMode 2
	HighRes 1
	FileCircuit 2D/Menu/Circuit.tga
	FileFlare 2D/Menu/CircuitFlare.tga
	X 256
	Y 0
	AlphaCircuit 64
if $back
	item Background Sprite
		X 0
		Y 0
		ScaleX 640
		ScaleY 480
		Unit 1
		Alpha 92
		Red 0
		Green 0
		Blue 0
end

# ---- the bar behind a title: $y, $lx, $mx, $rx, $scale (computed from the width of the title) ----

menu titlebar
style bar
	HighRes 1
	IsMultiSprite 1
	BlendingMode 6
	File 2D/Menu/TitleBar.alpha.tga
style grey
	Alpha 50
	Red 110
	Green 110
	Blue 110
item TitleBarL Sprite bar
	SpriteIndex 1
	X $lx
	Y $y
	use grey
item TitleBarM Sprite bar
	SpriteIndex 2
	X $mx
	Y $y
	ScaleX $scale
	use grey
item TitleBarR Sprite bar
	SpriteIndex 3
	X $rx
	Y $y
	use grey

# ---- the cursor of a new menu ----

menu cursor
item Cursor Sprite
	HighRes 1
	File 2D/arrow.alpha.tga
	PivotX 0.25
	PivotY 0.0625

# ---- the defaults of a tab sprite: $control ----

menu tabdefaults
set $control HighRes 1
set $control BlendingMode 6
set $control File 2D/Menu/Tabs.alpha.tga
set $control TabSpriteIndex 1

# ---- a question: $title, $yes, $no (the functions), $y (the height of the title), $bary (of its bar), $exit (Yes
# ends the game) ----

menu yesno
item DoExit Text
	Font ScrapBig
	Text $title
	X 320
	Y $y
	CentralText 1
	Red 255
	Green 234
	Blue 177
	Effect Shadow
run titlebar $bary $title ScrapBig
item Yes Text
	Font ScrapBig
	Text "{Menu_Question_Yes}"
	X 280
	Y $y+60
	CentralText 1
	use blue
	OnAccept $yes
	Effect Shadow
item No Text
	Font ScrapBig
	Text "{Menu_Question_No}"
	X 360
	Y $y+60
	CentralText 1
	use blue
	OnAccept $no
	Effect Shadow
lr No Yes
lr Yes No
default No
call SScorer.SetOnCancel $id $no
if $exit == 0
	do backsub
	run circuit
end
set DoExit W 0
set DoExit H 0
if $exit
	run circuit
end

# ---- a text box: $desc, $accept, $back (the functions), $button (the text under it), $xbox ----

menu textbox
item MissionDesc Button
	IsMultiSprite 0
	IsNameValuePair 0
	MaxLineSize 340
	# the font always before the text
	Font Horatio
	Text $desc
	TextAlign Center
	TextColorAlpha 255
	TextColorRed 220
	TextColorGreen 230
	TextColorBlue 255
	ForceWidth 440
	ForceHeight 280
	X 100
	Y 100
	W 0
	H 0
	Visible 1
item WarningExit Text
if $xbox
	Font Horatio
	Text $button
	X 320
	Y 360
else
	Font ScrapBig
	Text $button
	X 320
	Y 380
end
	CentralText 1
	OnAccept $accept
	use blue
	Effect Shadow
item WarningTab Tab
let control WarningTab
do tabdefaults
	X 93
	Y 93
	SizeX 455
	SizeY 295
	TabInit 0
	TabEnd 0
	TabMax 0
	SizeTabQuad 0
	BlendingMode 6
	Type 2
	Alpha 92
	Red 40
	Green 200
	Blue 40
call SScorer.SetOnCancel $id $back
default WarningExit
run circuit

# ---- a slider: $name, $x, $y ----

menu slider
style circuit
	IsMultiSprite 1
	HighRes 1
	BlendingMode 2
	File 2D/Menu/Slider.alpha.tga
	X $x
item $(name) Slider
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/Slider.alpha.tga
	X $x
	Y $y+8
	W 125
	H 26
	FocusPivotX -8
	FocusPivotY -5
	BackSpriteIndex 1
	SliderSpriteIndex 2
	FocusSpriteIndex 4
	Alpha 255
	Red 255
	Green 255
	Blue 255
	MinValue 0
	MaxValue 10
	ValueStep 0.5
	MarginSize 15
item $(name)Circuit1 Sprite circuit
	Y $y+2
	SpriteIndex 3
	Alpha 164
item $(name)Circuit2 Sprite circuit
	Y $y+20
	SpriteIndex 3
	Alpha 164

# ---- the arrows left and right of a value: $name, $x, $y (of the value), $size (its width) ----

menu prevnext
let ay $y 6
let px $x -26
let nx $x $size 8
item $(name)Prev Button arrow
	X $px
	Y $ay
	W 25
	H 25
	FocusPivotX -5
	FocusPivotY -5
	Complex 0
	Visible 1
	Rotate 0
item $(name)PrevBack Sprite arrowback
	X $px-3
	Y $ay-3
item $(name)PrevCircuit1 Sprite
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/GenericButtons.alpha.tga
	SpriteIndex 16
	X $px+16
	Y $ay-12
	Rotate 1
	Mirror 2
item $(name)PrevCircuit2 Sprite
	BlendingMode 2
	IsMultiSprite 1
	HighRes 1
	File 2D/ShipEditor/Circuits.tga
	SpriteIndex 3
	X $px-10
	Y $ay-18
	Alpha 128
	Rotate 3
	Mirror 0
item $(name)Next Button arrow
	X $nx
	Y $ay
	W 25
	H 25
	FocusPivotX -5
	FocusPivotY -5
	Complex 0
	Mirror 1
	Visible 1
item $(name)NextBack Sprite arrowback
	X $nx-3
	Y $ay-3
item $(name)NextCircuit1 Sprite
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/GenericButtons.alpha.tga
	SpriteIndex 16
	X $nx-9
	Y $ay-12
	Rotate 1
	Mirror 0
item $(name)NextCircuit2 Sprite
	BlendingMode 2
	IsMultiSprite 1
	HighRes 1
	File 2D/ShipEditor/Circuits.tga
	SpriteIndex 3
	X $nx-8
	Y $ay-18
	Alpha 128
	Rotate 3
	Mirror 2
let bx $x 2
let bs $size -4
item $(name)Back Tab
let control $(name)Back
do tabdefaults
	X $bx
	Y $ay-10
	SizeX $bs
	SizeY 36
	Type 4
	Alpha 32
	Red 92
	Green 92
	Blue 128

menu prevnextsimple
let ay $y -8
let px $x 8
let nx $x $size -24
item $(name)Prev Button arrow
	X $px
	Y $ay
	W 25
	H 25
	FocusPivotX -5
	FocusPivotY -5
	Complex 0
	Visible 1
	Rotate 0
item $(name)PrevBack Sprite arrowback
	X $px-3
	Y $ay-3
item $(name)Next Button arrow
	X $nx
	Y $ay
	W 25
	H 25
	FocusPivotX -5
	FocusPivotY -5
	Complex 0
	Mirror 1
	Visible 1
item $(name)NextBack Sprite arrowback
	X $nx-3
	Y $ay-3
item $(name)Back Tab
let control $(name)Back
do tabdefaults
	X $x
	Y $ay-8
	SizeX $size
	SizeY 32
	Type 4
	Alpha 64
	Red 92
	Green 102
	Blue 128
