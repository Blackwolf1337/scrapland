# The mission info pages (Menu.MenuMissionInfo of the game): the primary mission with the radar, the crazy deal and
# the notes, with the arrows to the other two. The format is described in src/game/Script/Script.c. A pack in mods/
# with scrapc/menus/mission.menu replaces this file.

# ---- a page: $page, $ltitle and $rtitle (the pages left and right), the colours $red $green $blue (of the frame)
# and $tred $tgreen $tblue (of the texts), $xbox, $outdoor; run content gives $title, $desc, $hintl and $hintr ----

menu page
call Scorer.CreateMissionScorer $id enabled=0
item Hint Hint
	Font Horatio
	Align Center
	X 320
	Y 390
	Visible 1
	Red 251
	Green 241
	Blue 174
	TabBlendingMode 6
	TabSprite 2D/Menu/Tabs.alpha.tga
	TabSpriteIndex 1
	TabAlpha 164
	TabRed 100
	TabGreen 140
	TabBlue 203
# the description of the page and its objectives or notes
run content
call SScorer.SetOnPrev $id Menu.Go$(ltitle)
call SScorer.SetOnNext $id Menu.Go$(rtitle)
item PrimaryMissionTitle Text
	Font Horatio
	Effect Shadow
	Text $title
	Alpha 255
	Red $tred
	Green $tgreen
	Blue $tblue
	Align Center
	X 320
	Y 58
	Visible 1
if $xbox
	item MissionInfoExit Text
		Font Horatio
		Text $xboxback
		W 0
		H 0
		X 320
		Y %Menu.BackButtonYStart
		CentralText 1
		Effect Shadow
else
	item MissionInfoExit Text
		Font ScrapBig
		Text "{Menu_Back}"
		X 320
		Y %Menu.BackButtonYStart
		CentralText 1
		Red 183
		Green 220
		Blue 255
		Effect Shadow
end
	OnAccept Menu.ExitMissionInfo
item PrimaryMissionDesc Button
	IsMultiSprite 0
	IsNameValuePair 0
	MaxLineSize 427
	# the font always before the text
	Font HoratioSmall
	Text $desc
	TextColorAlpha 255
	TextColorRed $tred
	TextColorGreen $tgreen
	TextColorBlue $tblue
	ForceWidth 530
	ForceHeight 350
	W 0
	H 0
	X 55
	Y 82
	Visible 1
if $page == PrimaryMission
	call Scorer.CreateRadarScorer $id
	if $outdoor
		set Radar Map2dScale 1024
		set Radar MenuMinScale 682
		set Radar MenuMaxScale 4096
		set Radar MenuScaleSpeed 2048
	else
		set Radar Map2dScale 55
		set Radar MenuMinScale 30
		set Radar MenuMaxScale 150
		set Radar MenuScaleSpeed 50
	end
	set Radar Map2dScaleFactor 0
	set Radar MenuMap 1
	set Radar Y 205
	set Radar X 120
end
item TabMissionDesc Tab
call Menu.SetTabDefaults $id TabMissionDesc
	X 48
	Y 40
	SizeX 544
	SizeY 372
	TabInit 0
	TabEnd 0
	TabMax 0
	SizeTabQuad 0
	Type 3
	Alpha 128
	Red $red
	Green $green
	Blue $blue
item TabMissionBackground Tab
call Menu.SetTabDefaults $id TabMissionBackground
	X 45
	Y 37
	SizeX 550
	SizeY 406
	TabInit 0
	TabEnd 0
	TabMax 0
	SizeTabQuad 0
	Type 2
	Alpha 32
	Red 140
	Green 194
	Blue 240
# the arrow to the page on the left
style tabsmenu
	IsMultiSprite 1
	HighRes 1
	File 2D/Menu/TabsMenu.alpha.tga
item $(ltitle) Button tabsmenu
	Complex 0
	Highlight 1
	SpriteIndex 2
	FocusSpriteIndex 3
	X 57
	Y 397
	W 35
	H 35
	FocusPivotX -5
	FocusPivotY -5
	OnAccept Menu.MenuMissionInfo_Left
	MaxHintLineWidth 400
item $(ltitle)Back Sprite tabsmenu
	SpriteIndex 1
	X 52
	Y 393
item $(ltitle)Parentesis Sprite tabsmenu
	SpriteIndex 16
	X 89
	Y 393
	Rotate 0
	Mirror 1
item $(ltitle)Circuit Sprite
	BlendingMode 2
	use tabsmenu
	SpriteIndex 7
	X 49
	Y 382
	Alpha 128
	Rotate 0
	Mirror 0
# the arrow to the page on the right
item $(rtitle) Button tabsmenu
	Complex 0
	Highlight 1
	SpriteIndex 2
	FocusSpriteIndex 3
	X 554
	Y 397
	W 35
	H 35
	FocusPivotX -5
	FocusPivotY -5
	Mirror 1
	OnAccept Menu.MenuMissionInfo_Right
	MaxHintLineWidth 400
item $(rtitle)Back Sprite tabsmenu
	SpriteIndex 1
	X 550
	Y 393
item $(rtitle)Parentesis Sprite tabsmenu
	SpriteIndex 16
	X 535
	Y 393
	Rotate 0
	Mirror 0
item $(rtitle)Circuit Sprite
	BlendingMode 2
	use tabsmenu
	SpriteIndex 7
	X 507
	Y 382
	Alpha 128
	Rotate 0
	Mirror 1
set $ltitle Hint $hintl
set $rtitle Hint $hintr
call SScorer.SetOnCancel $id Menu.ExitMissionInfo
lr $ltitle MissionInfoExit
lr MissionInfoExit $rtitle
default MissionInfoExit
call Menu.DrawCircuitMenu $id

# ---- one line of objectives or notes: $num, $y, $text1, $text2 (right, may be empty), the colours as above ----

menu objective
item Objetive$(num) Text
	Font Horatio
	Text $text1
	Alpha 255
	Red $tred
	Green $tgreen
	Blue $tblue
	Align Left
	X 64
	Y $y
	Visible 1
if $text2 != ""
	item ObjetiveRes$(num) Text
		Font Horatio
		Text $text2
		Alpha 255
		Red $tred
		Green $tgreen
		Blue $tblue
		Align Right
		X 570
		Y $y
		Visible 1
end
item ObjetiveTab$(num) Tab
call Menu.SetTabDefaults $id ObjetiveTab$(num)
	X 55
	Y $y-5
	SizeX 528
	SizeY 40
	TabInit 0
	TabEnd 0
	TabMax 0
	SizeTabQuad 0
	Type 0
	Alpha 1
	Red $red
	Green $green
	Blue $blue
