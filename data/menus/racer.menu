# The HUD in a ship and the scores of a game (the RacerScorer module of the game). The C functions in
# src/game/Script/MenuHud.c give the margins as $mh and $mv and pick a section. The format is described in
# src/game/Script/Script.c. A pack in mods/ with scrapc/menus/racer.menu replaces this file.

style blue
	Red 183
	Green 220
	Blue 255
style white
	Red 255
	Green 255
	Blue 255

# ---- the weapons at the top left ----

menu weapon
item Weapon Weapon
	X $mh
if $id == 1
	Y $mv+246
else
	Y $mv+6
end
	Sprite 2D/HUD/HUD.alpha.tga
	BackOffX 0
	BackOffY 0
	BackIndex 1
	Weapons3DSprite 2D/HUD/WeaponIcons3D.alpha.tga
	WeaponIconOffX 13
	WeaponIconOffY 18
	WeaponIconShadowOffX 4
	WeaponIconShadowOffY 4
	WeaponIconAc 6
	WeaponIconIndex 20
	WeaponIconAc 0
	WeaponIconIndex 1
	WeaponIconAc 3
	WeaponIconIndex 4
	WeaponIconAc 2
	WeaponIconIndex 7
	WeaponIconAc 4
	WeaponIconIndex 10
	WeaponIconAc 1
	WeaponIconIndex 13
	WeaponIconAc 5
	WeaponIconIndex 16
	UpgradeBarOffX 6.5
	UpgradeBarOffY 11.5
	UpgradeBarIndex 3
	UpgradeBarRed 251
	UpgradeBarGreen 241
	UpgradeBarBlue 92
	UpgradeBarAlpha 128
	UpgradeIconOffX 1.5
	UpgradeIconOffY 0.5
	UpgradeIconAc 0
	UpgradeIconIndex 0
	UpgradeIconAc 1
	UpgradeIconIndex 2
	UpgradeIconAc 2
	UpgradeIconIndex 3
	UpgradeIconAc 7
	UpgradeIconIndex 5
	UpgradeIconAc 8
	UpgradeIconIndex 6
	UpgradeIconAc 5
	UpgradeIconIndex 9
	UpgradeIconAc 6
	UpgradeIconIndex 8
	UpgradeIconAc 9
	UpgradeIconIndex 11
	UpgradeIconAc 10
	UpgradeIconIndex 12
	UpgradeIconAc 3
	UpgradeIconIndex 14
	UpgradeIconAc 4
	UpgradeIconIndex 15
	UpgradeIconAc 11
	UpgradeIconIndex 17
	UpgradeIconAc 12
	UpgradeIconIndex 18
	AmmoBackIndex 27
	AmmoBackOffX 68
	AmmoBackOffY 12.5
	AmmoBarOffX 61.5
	AmmoBarOffY 37
	AmmoBarIndex 6
	AmmoTextOffX 58
	AmmoTextOffY 66
	AmmoIconOffX 68
	AmmoIconOffY 11
	AmmoIconAc 0
	AmmoIconIndex 10
	AmmoIconAc 1
	AmmoIconIndex 12
	AmmoIconAc 2
	AmmoIconIndex 11
	AmmoIconAc 3
	AmmoIconIndex 9
	AmmoFont BigNumbers
	AmmoTextRed 251
	AmmoTextGreen 241
	AmmoTextBlue 174
	AmmoTextAlpha 255
	FontBackIndex 26
	FontBackOffX 36
	FontBackOffY 67
	SlotsOffX 36
	SlotsOffY 2
	SlotsIndex0 7
	SlotsIndex1 8
	TabBlendingMode 3
	TabSprite 2D/Menu/Tabs.alpha.tga
	TabSpriteIndex 1
	TabAlpha 255
	TabRed 255
	TabGreen 255
	TabBlue 192

# ---- the cross hair of the cannon ----

menu cannon
item Cannon Cannon
	Sprite 2D/HUD/Cannon.alpha.tga
	CrossHairIndex 1
	AimAc 0
	AimIndex 5
	AimAc 1
	AimIndex 9
	AimAc 2
	AimIndex 7
	AimAc 3
	AimIndex 6
	AimAc 4
	AimIndex 8
	AimAc 5
	AimIndex 10
	AimAc 6
	AimIndex 4

# ---- the locked target ----

menu target
item Target Target
	Sprite 2D/Racer/Target.alpha.tga
	TargetRectIndex 38
	TargetArrowIndex 16
	EnemyFireIndex 4

# ---- the waypoint ----

menu waypoint
item Waypoint Waypoint
	Sprite 2D/Racer/Target.alpha.tga
	WaypointRectIndex 38
	WaypointArrowIndex 47

# ---- the radar of a ship ----

menu radar
call Scorer.CreateRadarScorer $id
set Radar Map2dScale 1024
set Radar Map2dScaleFactor 0.025

# ---- the HUD of a ship (CreateRacer): $net (a network game), $camera (the camera has an entity), $spectator (it
# follows another player), $target (it has a target), $showlocal (the own cannon), $split, $online (client or
# server), $descriptor ----

menu racer
if $net
	item Chat Chat
		NumMsg 5
		X 106
end
if $camera
	if $spectator
		item PlySpt Text
			X 320
			Y 75
			Align Center
			use white
			Text "{Net_Label_Spectator}"
		item PlyDes Text
			X 320
			Y 100
			Align Center
			use white
		if $target
			Text $descriptor
		else
			Text ""
			call Scorer.CreateMsgScorer $id
		end
	end
	if $target
		call Scorer.CreateMsgScorer $id
		if $showlocal
			call RacerScorer.CreateCannonScorer $id
		end
		call RacerScorer.CreateTargetScorer $id
		call RacerScorer.CreateWaypointScorer $id
		call RacerScorer.CreateWeaponScorer $id
		call Scorer.CreateStatusScorer $id 0
		if $split == 0
			if $online == 0
				call Scorer.CreateCopMeterScorer $id
			end
			call RacerScorer.CreateRadarScorer $id
			call Scorer.CreateMonitorScorer $id 0
		end
		# the wind
		item WindFx WindFx
	end
end
# the statistics of the network
if $online
	item NetStats NetStats
		X 1
		Y 240
	set Msg Y 170
end

# ---- the scores (ShowScorer): $bottom and $top (the messages of the mode), $deal (0, or 1 with Yes and No, 2
# with Continue), $yes and $no (their functions); run rows puts one row per player ----

menu scores
item PlyDes Text
	Text $bottom
	X 320
	Align Center
	use blue
if $deal
	Y 390
else
	Y 412
end
item PlyMsg Text
	X 320
	Y 56
	Align Center
	use blue
	Text $top
item NetColumnBack_Title Sprite
	X 100
	Y 43
	Unit 1
	ScaleX 440
	ScaleY 27
	Alpha 24
item LineTop1 Sprite
	X 100
	Y 72
	ScaleX 440
	ScaleY 1
	Unit 1
	Alpha 24
if $deal == 1
	item Yes Text
		Text "{Menu_Question_Yes}"
		X 280
		Y 415
		CentralText 1
		use blue
		OnAccept $yes
		Effect Shadow
	item No Text
		Text "{Menu_Question_No}"
		X 360
		Y 415
		CentralText 1
		use blue
		OnAccept $no
		Effect Shadow
	set Yes Right No
	set No Left Yes
	set Cursor Visible 0
	default Yes
	call SScorer.SetOnCancel $id $no
elif $deal == 2
	item Yes Text
		Text "{SuperDeal_Continue}"
		X 320
		Y 415
		CentralText 1
		use blue
		OnAccept $yes
		Effect Shadow
	set Cursor Visible 0
	default Yes
	call SScorer.SetOnCancel $id $yes
end
run rows
item BackgroundTab Tab
call Menu.SetTabDefaults $id BackgroundTab
	X 92
	Y 36
	SizeX 456
	SizeY 408
	TabInit 0
	TabEnd 0
	TabMax 0
	SizeTabQuad 0
	Type 2
	Alpha 174
	Red 105
	Green 145
	Blue 255
call Menu.DrawCircuitMenu $id 0

# ---- one row of the scores: $n, $y, $liney (of the line under it), $font, $step (the height of a row), $name,
# $score, $ping (a text, empty without pings), $player (the entity, for the ping), the colours $r $g $b of the text
# and $br $bg $bb $ba of the back (no back when $ba is 0) ----

menu row
item Name$(n) Text
	Font $font
	Text $name
	X 102
	Y $y
	Red $r
	Green $g
	Blue $b
item Score$(n) Text
	Font $font
	Text $score
	X 530
	Y $y
	Align Right
	Red $r
	Green $g
	Blue $b
if $ping != ""
	item Ping$(n) Text
		Font $font
		Text $ping
		X 400
		Y $y
		Align Right
		Red $r
		Green $g
		Blue $b
		Hint $player
end
if $ba > 0
	item Back$(n) Sprite
		X 100
		Y $y-2
		ScaleX 440
		ScaleY $step
		Unit 1
		Red $br
		Green $bg
		Blue $bb
		Alpha $ba
end
item Line$(n) Sprite
	X 100
	Y $liney
	ScaleX 440
	ScaleY 1
	Unit 1
	Alpha 24

# ---- the scorer of a race or duel mission: $limit (its text) ----

menu mission
style number
	Font BigNumbers
style centrewhite
	Align Center
	Red 255
	Green 255
	Blue 255
item MissionBest Text
	X $mh+20
	Y 190
	use number
	Text ""
	use centrewhite
item MissionLimit Text
	X $mh+50
	Y 190
	use number
	Text $limit
	use centrewhite
item MissionBad Text
	X $mh+20
	Y 210
	use number
	Text ""
	use centrewhite
item MissionYou Sprite
	X $mh+5
	Y 180
	ScaleX 30
	ScaleY 20
	Unit 1
	Alpha 128
	Red 0
	Green 0
	Blue 255
item MissionSLimit Sprite
	X $mh+35
	Y 180
	ScaleX 30
	ScaleY 20
	Unit 1
	Alpha 64
	Red 0
	Green 0
	Blue 0
item MissionTab Tab
call Menu.SetTabDefaults $id MissionTab
	X $mh
	Y 175
	SizeX 70
	SizeY 50
	Type 4
	Alpha 128
	Red 32
	Green 64
	Blue 255

menu missionteam
set MissionSLimit X $mh+5
set MissionSLimit Red 0
set MissionSLimit Green 255
set MissionSLimit Blue 0
set MissionSLimit Alpha 128
set MissionYou Y 200
set MissionYou Red 255
set MissionYou Green 0
set MissionYou Blue 0
