# ---- HangarTab.SetHangarPanel: the keyboard links and the ship type buttons ($noship: no ship in the current hangar)
section links
default Hangar1
lr Hangar1 Hangar2
lr Hangar2 Hangar3
lr Hangar4 Hangar5
lr Hangar5 Hangar6
lr Hangar7 Hangar8
lr Hangar8 Hangar9
ud Hangar1 Hangar4
ud Hangar4 Hangar7
ud Hangar2 Hangar5
ud Hangar5 Hangar8
ud Hangar3 Hangar6
ud Hangar6 Hangar9
if $mp == 0
	ud Hangar7 HangarAux
	ud Hangar9 HangarAux
	ud Hangar8 HangarAux
	lr HangarAux Exit
	lr Hangar3 Exit
	lr Hangar9 Exit
	lr Hangar6 Exit
else
	lr PrevPilot NextPilot
	ud NextPilot PilotName
	ud PrevPilot PilotName
	ud PilotName Sell
	ud PilotName Exit
end
