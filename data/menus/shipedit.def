# ---- HangarTab.SetHangarPanel: the hint and the emergency ship ($aux9: HangarTab.currentHangar == 9)
section panel
item Hint Hint
	Font Horatio
	Align Center
	X 320
	Y 334
	Visible 1
	Red 251
	Green 241
	Blue 174
	TabBlendingMode 6
	TabSprite 2D/Menu/Tabs.alpha.tga
	TabSpriteIndex 1
	TabAlpha 164
	TabRed 100
	TabGreen 140
	TabBlue 203
if $mp == 0
	item nAux Text
		Font HoratioSmall
		Text E
		Align Center
		Red 83
		Green 114
		Blue 193
		X 86
		Y 354
	item LittleShipAux Button
		Discardable 1
		IsMultiSprite 1
		HighRes 1
		File 2D/ShipEditor/HangarOnly.alpha.tga
		Highlight 0
		SpriteIndex 4
		X 57
		Y 337
		Red 83
		Green 114
		Blue 193
	item HangarAux Button
		Discardable 1
		BlendingMode 6
		IsMultiSprite 1
		HighRes 1
		File 2D/ShipEditor/HangarOnly.alpha.tga
		Highlight 1
		SpriteIndex 1
		FocusSpriteIndex 3
		X 52
		Y 330
		W 46
		H 46
		Complex 0
		Alpha 255
		if $sputnik == 0
			OnAccept HangarTab.SelectItem
		else
			OnAccept SputnikInterface.SelectShip
		end
		OnGainFocus HangarTab.ShowShipMiniInfo
		OnLooseFocus HangarTab.HideShipMiniInfo
		if $sputnik
			run use Hint HINT_Sputnik_ValidShip
		elif $aux9
			Hint "{HINT_Hangar18}"
		else
			run use Hint HINT_Hangar17
		end
	item AuxShipText Text
		Font Horatio
		Text "{ShipEdit_AuxiliaryShip}"
		Align Left
		Alpha 255
		Red 210
		Green 32
		Blue 32
		Effect Shadow
		X 100
		Y 340
		Visible 0
end

# ---- HangarTab.SetHangarPanel: hangar $n (1 to 9) at $x $y
section hangar
item n$(n) Text
	Font HoratioSmall
	Text "$(n)"
	Align Center
	Alpha 255
	Red 83
	Green 114
	Blue 193
	X $x+34
	Y $y+24
item LittleShip$(n) Button
	Discardable 1
	IsMultiSprite 1
	HighRes 1
	File 2D/ShipEditor/HangarOnly.alpha.tga
	Highlight 0
	SpriteIndex 4
	X $x+5
	Y $y+7
	Visible 0
	Alpha 255
	Red 83
	Green 114
	Blue 193
item Hangar$(n) Button
	Discardable 1
	BlendingMode 6
	IsMultiSprite 1
	HighRes 1
	File 2D/ShipEditor/HangarOnly.alpha.tga
	Highlight 1
	SpriteIndex 1
	FocusSpriteIndex 3
	X $x
	Y $y
	W 46
	H 46
	Complex 0
	Alpha 255
	if $sputnik == 0
		OnAccept HangarTab.SelectItem
		OnGainFocus HangarTab.ShowShipMiniInfo
		OnLooseFocus HangarTab.HideShipMiniInfo
		run use Hint HINT_Hangar10
	else
		OnAccept SputnikInterface.SelectShip
		OnGainFocus HangarTab.ShowShipMiniInfo
		OnLooseFocus HangarTab.HideShipMiniInfo
		run sputnikhint $n
	end

