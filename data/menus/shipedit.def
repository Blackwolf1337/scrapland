	IsMultiSprite 1
	HighRes 1
	File 2D/ShipEditor/Buttons.alpha.tga
	Complex 0
	Highlight 1
	if $sputnik
		SpriteIndex 5
		FocusSpriteIndex 6
	else
		SpriteIndex 2
		FocusSpriteIndex 3
	end
	Alpha 255
	Red 255
	Green 255
	Blue 255
	X 548
	Y 402
	W 35
	H 35
