call HangarTab.SetExitVisible $id 1
if $sputnik == 0
	set Exit OnAccept ShipEdit.ExitEditShipMenu
	run use Hint HINT_Hangar9 Exit
else
	set Exit OnAccept SputnikInterface.ExitSputnikInterface
	set Exit Hint "{HINT_Sputnik_Cancel}"
end

# ---- HangarTab.SetHangarPanel: the head of a pilot ($name, $model) in a network game
