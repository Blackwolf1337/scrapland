# sentinelsound (the sound script sound/sentinelsound.py of the game): the sound files of the character class
# (LoadSounds), the sound events of its actions (SetSounds and the Talk sections, through Chars.ActSound), the loops of
# a new entity (InitLoops, $name the entity) and Init, which runs them with $char the class. The format is described in
# src/game/Script/Script.c; the C is in src/game/Script/Sounds.c. A pack in mods/ with scrapc/sound/sentinelsound.def
# replaces this file.

section LoadSounds
class
	AddSoundRes loop-sentinel.wav
	AddSoundRes sesgado111.wav
	AddSoundRes mecanismo-sentinel1.wav
	AddSoundRes mecanismo-sentinel2.wav
	AddSoundRes mecanismo-sentinel3.wav
	AddSoundRes mecanismo-sentinel4.wav
	AddSoundRes beep-sentinel1.wav
	AddSoundRes beep-sentinel2.wav
	AddSoundRes beep-sentinel3.wav
	AddSoundRes beep-sentinel4.wav
	AddSoundRes beep-sentinel5.wav
	AddSoundRes beep-sentinel6.wav
	AddSoundRes beep-sentinel7.wav
	AddSoundRes rasca1.wav
	AddSoundRes rasca2.wav

section SetSounds
let act ActionInit
call Chars.ActSound $char $act 2 mecanismo-sentinel4 0.035 +3
call Chars.ActSound $char $act 9 mecanismo-sentinel1 0.032 -1
call Chars.ActSound $char $act 19 mecanismo-sentinel2 0.032 -2
call Chars.ActSound $char $act 19 sesgado111 0.06
let act Action
call Chars.ActSound $char $act 45 mecanismo-sentinel3 0.035
call Chars.ActSound $char $act 55 mecanismo-sentinel4 0.035
let act Relax0
call Chars.ActSound $char $act 6 beep-sentinel1 0.07
call Chars.ActSound $char $act 10 mecanismo-sentinel3 0.02
call Chars.ActSound $char $act 20 mecanismo-sentinel4 0.02
call Chars.ActSound $char $act 41 beep-sentinel2 0.07
call Chars.ActSound $char $act 66 mecanismo-sentinel3 0.02 -2
call Chars.ActSound $char $act 67 beep-sentinel5 0.07
call Chars.ActSound $char $act 83 mecanismo-sentinel4 0.012 -3
call Chars.ActSound $char $act 84 beep-sentinel4 0.07
call Chars.ActSound $char $act 115 beep-sentinel3 0.07
call Chars.ActSound $char $act 117 mecanismo-sentinel3 0.02 +2
let act Relax1
call Chars.ActSound $char $act 2 mecanismo-sentinel4 0.02 +2
call Chars.ActSound $char $act 5 mecanismo-sentinel1 0.015
call Chars.ActSound $char $act 20 mecanismo-sentinel4 0.02 +4
call Chars.ActSound $char $act 21 rasca1 0.01
call Chars.ActSound $char $act 29 mecanismo-sentinel3 0.02
call Chars.ActSound $char $act 37 mecanismo-sentinel4 0.02 +4
call Chars.ActSound $char $act 38 rasca2 0.01
call Chars.ActSound $char $act 48 mecanismo-sentinel3 0.02
call Chars.ActSound $char $act 57 mecanismo-sentinel4 0.02 +4
call Chars.ActSound $char $act 58 rasca1 0.01
call Chars.ActSound $char $act 70 mecanismo-sentinel4 0.02 +2
call Chars.ActSound $char $act 80 mecanismo-sentinel1 0.015 -1
let act WalkInit
call Chars.ActSound $char $act 2 beep-sentinel6 0.07
let act WalkEnd
call Chars.ActSound $char $act 54 beep-sentinel7 0.07
call Chars.ActSound $char $act 60 mecanismo-sentinel4 0.02 -3
let act BackInit
call Chars.ActSound $char $act 3 beep-sentinel6 0.07
let act BackEnd
call Chars.ActSound $char $act 54 beep-sentinel7 0.07
call Chars.ActSound $char $act 60 mecanismo-sentinel3 0.02 -3
let act StrLeftInit
call Chars.ActSound $char $act 3 beep-sentinel6 0.07
let act StrLeftEnd
call Chars.ActSound $char $act 54 beep-sentinel2 0.07
call Chars.ActSound $char $act 60 mecanismo-sentinel3 0.02 -3
let act StrRightInit
call Chars.ActSound $char $act 3 beep-sentinel6 0.07
let act StrRightEnd
call Chars.ActSound $char $act 54 beep-sentinel5 0.07
call Chars.ActSound $char $act 60 mecanismo-sentinel3 0.02 -3
let act CrazyInit
call Chars.StrSound $char $act 1 Anm_dance6 0.35
call Chars.ActSound $char $act 1 mecanismo-sentinel3 0.02
let act Crazy
call Chars.ActSound $char $act 34 mecanismo-sentinel4 0.02
call Chars.ActSound $char $act 44 mecanismo-sentinel3 0.02
let act CrazyEnd
call Chars.ActSound $char $act 54 mecanismo-sentinel3 0.02
call Chars.StrSoundStop $char $act 54
let act FlashedInit
call Chars.ActSound $char $act 2 mecanismo-sentinel4 0.02
let act FlashedEnd
call Chars.ActSound $char $act 46 mecanismo-sentinel3 0.02
let talk Talk
do TalkSnd
let talk TalkNPC
do TalkSnd
let talk Talk0
do Talk0Snd
let talk TalkNPC0
do Talk0Snd
let talk Talk1
do Talk1Snd
let talk TalkNPC1
do Talk1Snd

section TalkSnd

section Talk0Snd
call Chars.ActSound $char $talk 6 mecanismo-sentinel2 0.025
call Chars.ActSound $char $talk 22 mecanismo-sentinel1 0.025
call Chars.ActSound $char $talk 39 mecanismo-sentinel1 0.025

section Talk1Snd
call Chars.ActSound $char $talk 4 mecanismo-sentinel2 0.025
call Chars.ActSound $char $talk 10 mecanismo-sentinel1 0.025
call Chars.ActSound $char $talk 20 mecanismo-sentinel2 0.025 +2
call Chars.ActSound $char $talk 29 mecanismo-sentinel3 0.025 +2
call Chars.ActSound $char $talk 38 mecanismo-sentinel4 0.025 +2
call Chars.ActSound $char $talk 44 mecanismo-sentinel1 0.025 +2

section InitLoops
entity $name
	snd_n 1
	snd00_name loop-sentinel
	snd00_loop 1
	snd00_pitch0 0.0
	snd00_vol0 0.025
	snd00_pitch1 +8.0
	snd00_vol1 0.06

section Init
call Scrap.OpenPack Sounds/Chars/$(char)
do LoadSounds
call Scrap.ClosePack
do SetSounds
run print "Sounds for $(char) loaded!"
