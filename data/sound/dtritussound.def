# dtritussound (the sound script sound/dtritussound.py of the game): the sound files of the character class
# (LoadSounds), the sound events of its actions (SetSounds and the Talk sections, through Chars.ActSound), the loops of
# a new entity (InitLoops, $e its handle) and Init, which runs them with $char the class. The format is described in
# src/game/Script/Script.c; the C is in src/game/Script/Sounds.c. A pack in mods/ with scrapc/sound/dtritussound.def
# replaces this file.

section LoadSounds
class
	AddSoundRes paso-detritus1.wav
	AddSoundRes paso-detritus3.wav
	AddSoundRes caida-dtritus.wav
	AddSoundRes action.wav
	AddSoundRes mecanismo-dtritus1.wav
	AddSoundRes mecanismo-dtritus2.wav
	AddSoundRes mecanismo-dtritus3.wav
	AddSoundRes mecanismo-dtritus4.wav
	AddSoundRes mecanismo-dtritus5.wav
	AddSoundRes mecanismo-dtritus6.wav

section SetSounds
let act Turn
call Chars.ActSound $char $act 8 mecanismo-dtritus1 0.026 +4
call Chars.ActSound $char $act 10 paso-detritus1 0.055
call Chars.ActSound $char $act 18 mecanismo-dtritus1 0.026 +4
call Chars.ActSound $char $act 20 paso-detritus3 0.055
let act TurnAlarm
