# doorsound (the sound script sound/doorsound.py of the game): the sound events of the door classes (SetSlide,
# $class the action class Door<name>, $act the action the next lines add to; run initsound <args> is
# DoorSound.SetInitDoorSound(args), the default sounds at the start of an action) and of the conversion point
# (ConversorSetSounds, $char its class).
# The format is described in src/game/Script/Script.c, the C that runs the sections is src/game/Script/GameSounds.c.
# A pack in mods/ with scrapc/sound/doorsound.def replaces this file.

section SetSlide
if $class == DoorElevatorOrbit
	let act Open
	call Chars.ActSound $class $act 10 cuchilla1 0.30
	call Chars.ActSound $class $act 10 up1 0.80 -4
	call Chars.ActSound $class $act 10 ascensor-orbit2 0.50
	call Chars.ActSound $class $act 13 cuchilla1 0.30
	call Chars.ActSound $class $act 17 cuchilla1 0.30
	call Chars.ActSound $class $act 20 cuchilla1 0.30
	let act Close
	call Chars.ActSound $class $act 46 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 46 up1 1.0 -4
	call Chars.ActSound $class $act 45 ascensor-orbit2 0.80
	call Chars.ActSound $class $act 51 clik-mecanismo1 0.50 -8
	call Chars.ActSound $class $act 50 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 55 clik-mecanismo1 0.50 -8
	call Chars.ActSound $class $act 53 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 59 clik-mecanismo1 0.50 -8
	call Chars.ActSound $class $act 57 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 63 clik-mecanismo1 0.50 -8
	let act Up
	call Chars.ActSound $class $act 92 subida-ascensor2 0.20 +2
	let act Down
	call Chars.ActSound $class $act 123 bajada-ascensor2 0.40 +2
	call Chars.ActSound $class $act 128 cierre1 0.20 +2
elif $class == DoorElevatorOrbitB
	let act Down
	call Chars.ActSound $class $act 9 cuchilla1 0.30
	call Chars.ActSound $class $act 18 cuchilla1 0.30
	call Chars.ActSound $class $act 22 cuchilla1 0.30
	call Chars.ActSound $class $act 25 up1 0.80 -4
	call Chars.ActSound $class $act 26 cuchilla1 0.30
	call Chars.ActSound $class $act 32 cuchilla1 0.30
	call Chars.ActSound $class $act 41 up1 0.80 -4
	let act Up
	call Chars.ActSound $class $act 5 up1 0.30
	call Chars.ActSound $class $act 15 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 18 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 22 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 27 cuchilla2 0.30 +2
	call Chars.ActSound $class $act 38 cuchilla2 0.30 +2
elif $class == DoorElevatorOrbitC
	let act Down
	let act UP
elif $class == DoorTeleporter
	let act Open
	call Chars.ActSound $class $act 35 placas-metal22 0.50
	call Chars.ActSound $class $act 34 apertura2 0.3
	let act Close
	call Chars.ActSound $class $act 6 placas-metal22 0.50
	call Chars.ActSound $class $act 22 placas-metal22 0.50 +3
	call Chars.ActSound $class $act 1 apertura2 0.3
	call Scrap.Set CharacterTeleportUpSound transporter3
	call Scrap.Set CharacterTeleportDownSound transporter4
	call Scrap.Set CharacterTeleportSoundVol 0.7
elif $class == DoorTempleTeleporter
