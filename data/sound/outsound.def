# outsound (the sound script sound/outsound.py of the game): the engine, weapon, hook and crash sounds of a ship
# (SetVehicleSounds: the sound variables of the entity $name, $model the model in capitals, $pc for the PC sounds,
# $armed when the weapon sounds are set, that is outside the indoor traffic), the sound files the outdoor levels load
# (LoadEngines, LoadWeapons, LoadScorer, LoadMisc, LoadCrash) and the engine variables of Init.
# The format is described in src/game/Script/Script.c, the C that runs the sections is src/game/Script/GameSounds.c.
# A pack in mods/ with scrapc/sound/outsound.def replaces this file.

section SetVehicleSounds
entity $name
if $pc
	if $model == MADHUNT
		do Engine1
	elif $model == TLIGHT3
		do Engine1
	elif $model == SPOLI2
		do Engine2
	elif $model == SPOLI3
		do Engine2
	elif $model == SMERC3
		do Engine2
	elif $model == SPOLI5
		do Engine2
	elif $model == SBANKMASTER1
		do Engine2
	elif $model == SBETTY1
		do Engine2
	elif $model == SBANKER1
		do Engine3
	elif $model == SMERC1
		do Engine3
	elif $model == SPOLIBOSS1
		do Engine3
	elif $model == SBERTO1
		do Engine3
	elif $model == SHUMP1
		do Engine3
	elif $model == SMOSQUITO
			snd00_name mosca2
			snd00_loop 1
			snd00_pitch0 -2.0
			snd00_vol0 0.03
			snd00_pitch1 4.0
			snd00_vol1 0.12
			snd00_pitch2 10.0
			snd00_vol2 0.14
			snd00_time0 1.2
			snd00_dopp 0.5
	elif $model == SLIFEBOAT
			snd00_name motor222B
			snd00_loop 1
			snd00_pitch0 -10.0
			snd00_vol0 0.05
			snd00_pitch1 -2.0
			snd00_vol1 0.12
			snd00_pitch2 +5.0
			snd00_vol2 0.20
			snd00_time0 1.2
			snd00_dopp 0.5
	elif $model == SMAYOR1
		do Engine4
	elif $model == SMERC1
		do Engine4
	elif $model == SMERC2
		do Engine4
	elif $model == SPOLI3
		do Engine4
	elif $model == SPOLI4
		do Engine4
	elif $model == SFUNC1
		do Engine4
	elif $model == SBISHOP1
		do Engine4
	elif $model == SARCHBISHOP1
		do Engine4
	elif $model == SBOSS1
		do Engine4
	elif $model == TMED1
		do Engine5
	elif $model == TMED2
		do Engine5
	elif $model == TMED3
		do Engine5
	elif $model == THEAVY1
		do Engine6
	elif $model == THEAVY2
		do Engine6
	elif $model == THEAVY3
		do Engine6
	elif $model == TLIGHT1
		do Engine7
	elif $model == TLIGHT2
		do Engine7
	elif $model == TLIGHT3
		do Engine7
	else
			snd00_name EngDiesel98b
			snd00_loop 1
			snd00_pitch0 0.0
			snd00_vol0 0.05
			snd00_pitch1 +12.0
			snd00_vol1 0.10
			snd00_pitch2 +25.0
			snd00_vol2 0.12
			snd00_time0 1.2
			snd00_dopp 0.5
	end
else
	if $model == SMOSQUITO
			snd00_name mosca2
			snd00_loop 1
			snd00_pitch0 -2.0
			snd00_vol0 0.03
			snd00_pitch1 4.0
			snd00_vol1 0.12
			snd00_pitch2 10.0
			snd00_vol2 0.14
			snd00_time0 1.2
			snd00_dopp 0.5
	elif $model == SLIFEBOAT
			snd00_name motor222B
			snd00_loop 1
			snd00_pitch0 -10.0
			snd00_vol0 0.05
			snd00_pitch1 -2.0
			snd00_vol1 0.12
			snd00_pitch2 +5.0
			snd00_vol2 0.20
			snd00_time0 1.2
			snd00_dopp 0.5
	elif $model == TLIGHT1
