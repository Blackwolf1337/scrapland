call Scrap.Set EMIThunderSoundAttIni 0.0
call Scrap.Set EMIThunderSoundAttEnd 0.0
call Scrap.Set EMIThunder1Sound EMIRayo1
call Scrap.Set EMIThunder2Sound EMIRayo2
