call Scrap.Set CannonScorerNoAmmoSoundVol 1.0

section LoadMisc
call SSound.LoadSound Misc/siren2.wav
call SSound.LoadSound Misc/SoloMotorBoom.wav
call SSound.LoadSound Misc/SoloMotorEngine.wav
call SSound.LoadSound Misc/ShipXplode.wav
call SSound.LoadSound Misc/FastFXWind.wav
call Scrap.Set WindFxScorerSound FastFXWind
call Scrap.Set WindFxScorerSoundVol 0.3
call Scrap.Set WindFxScorerSpeedVol 0.2
call Scrap.Set WindFxScorerSpeedPitch 7.0
call Scrap.Set WindFxScorerHorizontal 10000.0
call Scrap.Set WindFxScorerVertical 5000.0
call Scrap.Set WindFxScorerFadeFactor 5.0
call Scrap.Set WindFxScorerFwAngle 50.0
call Scrap.Set WindFxScorerShow 0
call SSound.LoadSound Misc/FireDrop.wav
call Scrap.Set FXElementsFireDropSound FireDrop
call Scrap.Set FXElementsFireDropSoundVol 0.5
call Scrap.Set FXElementsFireDropSoundAttIni 0.0
call Scrap.Set FXElementsFireDropSoundAttEnd 45000.0

section LoadCrash
call SSound.LoadSound Crash/VehicleCrashLo3.wav
call SSound.LoadSound Crash/VehicleCrashHeavy1.wav

section Init
call Scrap.Set SoundAutoplayVolume -60.0
call Scrap.Set SoundDopplerLevel 1.0
call Scrap.Set SoundDistAttenuation 0.05
call Scrap.Set NPCSndMotorVolFactor 2
