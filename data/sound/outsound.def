section LoadEngines
call SSound.LoadSound Engines/EngDiesel98C.wav
if $pc
	call SSound.LoadSound Engines/EngDiesel98b.wav
end
call SSound.LoadSound Engines/BoostDiesel16.wav
call SSound.LoadSound Engines/FailDiesel0.wav
call SSound.LoadSound Engines/BoomOnBoost2.wav
call SSound.LoadSound Engines/mosca2.wav
call SSound.LoadSound Engines/motor-heavy.wav
call SSound.LoadSound Engines/motor9.wav
