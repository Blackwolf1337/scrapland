section InitLoops

section Init
call Scrap.OpenPack Sounds/Chars/$(char)
do LoadSounds
call Scrap.ClosePack
do SetSounds
call Scrap.Set FunctionaryEffectFastSound effectfast
call Scrap.Set FunctionaryEffectFastSoundVol 0.4
run print "Sounds for $(char) loaded!"
