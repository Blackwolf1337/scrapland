if %PoliceSound.isPC
	call Chars.ActSound $char $act 11 golpe-mano 0.15
end
let act FlashedEnd
call Chars.ActSound $char $act 108 mecanismo-police1 0.03 +3
call Chars.ActSound $char $act 120 lenguaje-police1 0.15
let act DiscoverInit
call Chars.ActSound $char $act 6 mecanismo-police2 0.03 +3
call Chars.ActSound $char $act 8 lenguaje-police4 0.15
call Chars.ActSound $char $act 21 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 27 lenguaje-police8 0.015
call Chars.ActSound $char $act 29 mecanismo-police1 0.03 +7
call Chars.ActSound $char $act 33 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 34 Police-pasoB 0.035 -1
let act Discover
call Chars.ActSound $char $act 49 mecanismo-police1 0.03 +7
call Chars.ActSound $char $act 55 mecanismo-police2 0.03 +8
call Chars.ActSound $char $act 56 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 57 Police-pasoB 0.035 -1
let act Fusion
call Chars.ActSound $char $act 2 mecanismo-police2 0.016 -2
call Chars.ActSound $char $act 16 pluf 0.75 -2
call Chars.ActSoundLoop $char $act 10 2 0.45
call Chars.ActSound $char $act 21 mecanismo-police1 0.016
if %PoliceSound.isPC
	call Chars.ActSoundLoop $char $act 45 3 0.45
end
if %PoliceSound.isPC
	call Chars.ActSound $char $act 85 mecanismo-fusion5 0.18 +6
end
if %PoliceSound.isPC
	call Chars.ActSound $char $act 83 mecanismo-fusion6 0.18 +7
end
call Chars.ActSound $char $act 85 cierre-armadura 0.3
if %PoliceSound.isPC
	call Chars.ActSound $char $act 88 cierre-armadura2 0.3
	call Chars.ActSound $char $act 90 mecanismo-fusion6 0.18 +8
end
if %PoliceSound.isPC
	call Chars.ActSound $char $act 90 cierre-armadura2 0.3 +2
end
call Chars.ActSound $char $act 94 cierre-armadura 0.3
call Chars.ActSound $char $act 100 cierre-armadura 0.3
if %PoliceSound.isPC
	call Chars.ActSound $char $act 103 cierre-armadura2 0.3
end
call Chars.ActSound $char $act 105 cierre-armadura 0.3 +3
let act Laugh
call Chars.StrSound $char $act 2 Anm_comeon_police6 0.5
call Chars.ActSound $char $act 2 mecanismo-police2 0.03
call Chars.ActSound $char $act 15 mecanismo-police1 0.028 +7
call Chars.ActSound $char $act 21 mecanismo-police2 0.028 +8
call Chars.ActSound $char $act 27 mecanismo-police1 0.028 +7
call Chars.ActSound $char $act 33 mecanismo-police2 0.028 +8
call Chars.ActSound $char $act 39 mecanismo-police1 0.028 +7
call Chars.ActSound $char $act 45 mecanismo-police2 0.028 +8
call Chars.ActSound $char $act 51 mecanismo-police1 0.028 +7
call Chars.ActSound $char $act 57 mecanismo-police2 0.028 +8
call Chars.ActSound $char $act 63 mecanismo-police1 0.03
call Chars.ActSound $char $act 68 mecanismo-police2 0.03
class
	FallSound caida-police
	FallSoundVol 0.05
let talk Talk
do TalkSnd
let talk TalkNPC
do TalkSnd
let talk Talk0
do Talk0Snd
let talk TalkNPC0
do Talk0Snd
let talk Talk1
do Talk1Snd
let talk TalkNPC1
do Talk1Snd
let talk Talk2
do Talk2Snd
let talk TalkNPC2
do Talk2Snd

section TalkSnd

section Talk0Snd
call Chars.ActSound $char $talk 5 mecanismo-police1 0.02 +2
call Chars.ActSound $char $talk 16 mecanismo-police2 0.02 +2

section Talk1Snd
call Chars.ActSound $char $talk 2 mecanismo-police1 0.02 +5
call Chars.ActSound $char $talk 23 mecanismo-police2 0.02 +5
call Chars.ActSound $char $talk 45 mecanismo-police2 0.02 +5

section Talk2Snd
call Chars.ActSound $char $talk 6 mecanismo-police1 0.02 +2
call Chars.ActSound $char $talk 18 mecanismo-police2 0.02 +2
call Chars.ActSound $char $talk 42 mecanismo-police1 0.02 +2
let talk SirenInit
call Chars.ActSoundLoop $char $talk 6 1 0.1
let talk SirenEnd
call Chars.ActSoundLoop $char $talk 65 1 0

section InitLoops
if %PoliceSound.isPC
	entity $name
		snd_n 4
else
	entity $name
		snd_n 3
end
	snd01_name Siren1
	snd01_loop 1
	snd02_name efecto1
	snd02_loop 0
if %PoliceSound.isPC
	entity $name
		snd03_name efecto2
		snd03_loop 0
end

section Init
call Scrap.OpenPack Sounds/Chars/$(char)
do LoadSounds
call Scrap.ClosePack
do SetSounds
run print "Sounds for $(char) loaded!"
