let act CrazyInit
call Chars.StrSound $char $act 1 Anm_comeon_police5 0.5
let act Crazy
call Chars.ActSound $char $act 8 mecanismo-police2 0.03 +5
call Chars.ActSound $char $act 12 lenguaje-police9 0.15
call Chars.ActSound $char $act 63 mecanismo-police1 0.03 +5
if %PoliceSound.isPC
	call Chars.ActSound $char $act 68 ext-metal1 0.059 -3
end
call Chars.ActSound $char $act 106 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 116 lenguaje-police1 0.15 -2
if %PoliceSound.isPC
	call Chars.ActSound $char $act 117 ext-metal1 0.059 -2
end
call Chars.ActSound $char $act 167 mecanismo-police2 0.03 +5
let act FlashedInit
