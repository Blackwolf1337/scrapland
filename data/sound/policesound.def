call Chars.ActSound $char $act 15 Police-pasoB 0.035
call Chars.ActSound $char $act 14 mecanismo-police1 0.03 +4
call Chars.ActSound $char $act 20 mecanismo-police2 0.03 +4
call Chars.ActSound $char $act 25 mecanismo-police1 0.03 +4
