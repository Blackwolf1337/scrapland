# policesound (the sound script sound/policesound.py of the game): the sound files of the character class (LoadSounds),
# the sound events of its actions (SetSounds and the Talk sections, through Chars.ActSound), the loops of a new entity
# (InitLoops, $name the entity) and Init, which runs them with $char the class. The format is described in
# src/game/Script/Script.c; the C is in src/game/Script/Sounds.c. A pack in mods/ with scrapc/sound/policesound.def
# replaces this file.

section LoadSounds
class
	AddSoundRes Police-pasoA.wav
	AddSoundRes Police-pasoB.wav
	AddSoundRes Police-paso11.wav
	AddSoundRes Police-paso12.wav
	AddSoundRes mecanismo-police1.wav
	AddSoundRes mecanismo-police2.wav
	AddSoundRes lenguaje-police1.wav
	AddSoundRes lenguaje-police4.wav
	AddSoundRes lenguaje-police5.wav
	AddSoundRes lenguaje-police6.wav
	AddSoundRes lenguaje-police8.wav
	AddSoundRes lenguaje-police9.wav
	AddSoundRes lenguaje-police10.wav
	AddSoundRes lenguaje-police14.wav
	AddSoundRes lenguaje-police15.wav
	AddSoundRes lenguaje-police7.wav
	AddSoundRes rasca-Police1.wav
	AddSoundRes rasca-Police2.wav
	AddSoundRes comeon-police.wav
	AddSoundRes comeon-police2.wav
if %PoliceSound.isPC
	class
		AddSoundRes ext-metal1.wav
end
if %PoliceSound.isPC
	class
		AddSoundRes golpe-mano.wav
end
	AddSoundRes Siren1.wav
	AddSoundRes pluf.wav
	AddSoundRes efecto1.wav
if %PoliceSound.isPC
	class
		AddSoundRes efecto2.wav
end
	AddSoundRes cierre-armadura.wav
if %PoliceSound.isPC
	class
		AddSoundRes cierre-armadura2.wav
end
if %PoliceSound.isPC
	class
		AddSoundRes mecanismo-fusion5.wav
end
if %PoliceSound.isPC
	class
		AddSoundRes mecanismo-fusion6.wav
end
	AddSoundRes caida-police.wav

section SetSounds
let act Relax0
call Chars.ActSound $char $act 7 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 9 lenguaje-police14 0.15
call Chars.ActSound $char $act 31 mecanismo-police2 0.03 +5
call Chars.ActSound $char $act 32 lenguaje-police9 0.15
call Chars.ActSound $char $act 68 lenguaje-police1 0.15
call Chars.ActSound $char $act 72 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 100 lenguaje-police4 0.15
call Chars.ActSound $char $act 104 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 150 mecanismo-police2 0.03 -2
call Chars.ActSound $char $act 155 lenguaje-police6 0.15
let act Relax1
call Chars.ActSound $char $act 39 mecanismo-police2 0.03 -2
call Chars.ActSound $char $act 51 lenguaje-police10 0.15
call Chars.ActSound $char $act 91 rasca-Police1 0.025
call Chars.ActSound $char $act 107 rasca-Police2 0.025 +5
call Chars.ActSound $char $act 120 rasca-Police1 0.025 +5
call Chars.ActSound $char $act 132 rasca-Police2 0.025 +5
