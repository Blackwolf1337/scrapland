call Chars.ActSound $char $act 186 mecanismo-police2 0.03 +5
call Chars.ActSound $char $act 190 Police-paso11 0.03
let act Turn
call Chars.ActSound $char $act 1 mecanismo-police1 0.016 +5
call Chars.ActSound $char $act 7 Police-paso11 0.03
call Chars.ActSound $char $act 7 mecanismo-police2 0.016 +5
call Chars.ActSound $char $act 14 Police-paso12 0.03
let act Run
call Chars.ActSound $char $act 6 Police-pasoA 0.035
call Chars.ActSound $char $act 4 mecanismo-police1 0.014
call Chars.ActSound $char $act 13 mecanismo-police2 0.014
call Chars.ActSound $char $act 15 Police-pasoB 0.035
let act Back
call Chars.ActSound $char $act 6 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 4 mecanismo-police1 0.014 +5
call Chars.ActSound $char $act 13 mecanismo-police2 0.014 +5
call Chars.ActSound $char $act 15 Police-pasoB 0.035 -1
let act Walk
call Chars.ActSound $char $act 16 Police-pasoA 0.035
call Chars.ActSound $char $act 14 mecanismo-police1 0.014
call Chars.ActSound $char $act 25 mecanismo-police2 0.014
call Chars.ActSound $char $act 27 Police-pasoB 0.035
let act StrLeft
call Chars.ActSound $char $act 5 Police-pasoA 0.035 +1
call Chars.ActSound $char $act 5 mecanismo-police1 0.014
call Chars.ActSound $char $act 12 mecanismo-police2 0.014
call Chars.ActSound $char $act 14 Police-pasoB 0.035 +1
let act StrLeftInit
call Chars.ActSound $char $act 2 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 1 mecanismo-police1 0.014
let act StrRight
call Chars.ActSound $char $act 5 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 5 mecanismo-police1 0.014
call Chars.ActSound $char $act 12 mecanismo-police2 0.014
call Chars.ActSound $char $act 14 Police-pasoB 0.035 -1
let act StrRightInit
call Chars.ActSound $char $act 2 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 1 mecanismo-police2 0.014
let act FallInit
call Chars.ActSound $char $act 6 mecanismo-police1 0.016 +5
let act Fall
call Chars.ActSound $char $act 14 Police-pasoA 0.035 -1
call Chars.ActSound $char $act 15 Police-pasoB 0.035 -1
let actplus ""
let act ActionInit$(actplus)
call Chars.ActSound $char $act 7 mecanismo-police2 0.03 +5
call Chars.ActSound $char $act 18 comeon-police 0.6
call Chars.ActSound $char $act 17 mecanismo-police1 0.03 +4
call Chars.ActSound $char $act 37 mecanismo-police2 0.03 +4
call Chars.ActSound $char $act 38 comeon-police 0.6
let act Action$(actplus)
call Chars.ActSound $char $act 67 comeon-police2 0.3
call Chars.ActSound $char $act 72 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 83 mecanismo-police2 0.03 +5
let actplus NPC
let act ActionInit$(actplus)
call Chars.ActSound $char $act 7 mecanismo-police2 0.03 +5
call Chars.ActSound $char $act 18 comeon-police 0.6
call Chars.ActSound $char $act 17 mecanismo-police1 0.03 +4
call Chars.ActSound $char $act 37 mecanismo-police2 0.03 +4
