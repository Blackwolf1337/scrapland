call Chars.ActSound $char $act 72 mecanismo-police1 0.03 +5
call Chars.ActSound $char $act 83 mecanismo-police2 0.03 +5
let act ActionBad
call Chars.StrSound $char $act 1 Anm_comeon_police4 0.5
call Chars.ActSound $char $act 15 Police-pasoA 0.04
call Chars.ActSound $char $act 16 Police-pasoB 0.04
call Chars.ActSound $char $act 16 mecanismo-police2 0.03 +4
call Chars.ActSound $char $act 28 Police-pasoB 0.04
call Chars.ActSound $char $act 29 Police-pasoA 0.04
call Chars.ActSound $char $act 30 mecanismo-police1 0.03 +4
call Chars.ActSound $char $act 42 Police-pasoA 0.04
call Chars.ActSound $char $act 43 mecanismo-police2 0.03 +4
call Chars.ActSound $char $act 43 Police-pasoB 0.04
call Chars.ActSound $char $act 61 Police-paso11 0.04
call Chars.ActSound $char $act 68 Police-paso12 0.04
let act ActionOK
