# Nurse (the character script chars/nurse.py of the game): the Init that builds the action class. The format is
# described in src/game/Script/Script.c. A pack in mods/ with scrapc/chars/nurse.menu replaces this file. The C gives
# $xbox and $level (the path of the level in capitals). The sections OnCreate ($name: the new entity) and
# OnFreeResources are the callbacks of the class.

menu Nurse
call MakeChar.InitChar Nurse
setvar MakeChar.MaxSpeed 1.0
setvar MakeChar.MinSpeed 0.7
call MakeChar.AddRelaxActions Nurse 360
call MakeChar.AddWalkActions Nurse 360 0 0
call MakeChar.AddInitWalkActions Nurse 360 0 0
call MakeChar.AddEndWalkActions Nurse 360 0 0
call MakeChar.AddTalkAction Nurse nExtraActions=2
call MakeChar.AddFlashedAction Nurse
call MakeChar.AddCrazyAction Nurse
class Nurse
	CanFly 1
	FlyAccel 2400.0
	FlySpeed 500.0
	FlyFric 2.0
	FlyFallAccel 200.0
	SkipInitOnChange 0
	MinTimeWalking 0.3
	InitEndWalkInterpFactor 1.0
	CamDist 300
	CamAng -5
	CamRot 0
	WRadius 120
	VRadius 75
	SRadius 20
	Node0Name _Move_The_Model_
	Node1Name "Bip Tech-Medicina Head"
call MakeChar.SetNodeRotation 0 0 50 50
call MakeChar.SetNodeRotation 0 1 50 50
let ActionRotSpeed 360
action ActionInit
	AnmFilePath Models/Chars/Nurse/Anm/Nurse_ActionInit.M3D
	isLoop 0
	RotSpeed $ActionRotSpeed
	AngRotLimit 90
	UseDisp 0
	PriorityLevel 100
event &AnmTotalTime HammerReady !NurseInitHammerLoop
action ActionLoop
	AnmFilePath Models/Chars/Nurse/Anm/Nurse_ActionLoop.M3D
	isLoop 1
	RotSpeed $ActionRotSpeed
	AngRotLimit 90
	UseDisp 0
	PriorityLevel 101
action ActionFail
	AnmFilePath Models/Chars/Nurse/Anm/Nurse_ActionFail.M3D
	isLoop 0
	RotSpeed $ActionRotSpeed
	UseDisp 0
	PriorityLevel 101
event &AnmTotalTime HitBack !NurseBackHitControl
	EventDiscardable 0
event &AnmTotalTime TryToReuse !NurseTryHammerAgain
action ActionBlock
	AnmFilePath Models/Chars/Nurse/Anm/Nurse_ActionBlock.M3D
	isLoop 0
	RotSpeed 360
	UseDisp 0
	PriorityLevel 101
event 0.24 HammerHit !NurseDoHammerHit
event 1.0 HitBack !NurseBackHitControl
	EventDiscardable 0
event &AnmTotalTime TryToReuse !NurseTryHammerAgain
action ActionOK
	AnmFilePath Models/Chars/Nurse/Anm/Nurse_ActionOK.M3D
	isLoop 0
	RotSpeed 360
	UseDisp 0
	PriorityLevel 101
event 0.24 HammerHit !NurseDoHammerHit
event 1.0 HitBack !NurseBackHitControl
	EventDiscardable 0
event &AnmTotalTime TryToReuse !NurseTryHammerAgain
action BlockHit
	AnmFilePath Models/Chars/Nurse/Anm/Nurse_BlockHit.M3D
	AngRotLimit 360
	isLoop 0
	RotSpeed 1440
	UseDisp 0
	PriorityLevel 102
event &AnmTotalTime TryToReuse !NurseTryHammerAgain
event &AnmTotalTime HitBack !NurseBackHitControl
	EventDiscardable 0
class Nurse
	ActionPress !NurseActionPress
	ActionRelease !NurseActionRelease
	OnCreate Nurse.OnCreate
	OnFreeResources Nurse.OnFreeResources
call NurseSound.Init Nurse
if %Init.OutMapSkip == 0
	call Scrap.Set FXHammerHitFile %Nurse.HitFile
	call Scrap.SetDebrisSys %Nurse.HitFile 1 0 0 1 0 0 %Fx.FXSISTPART
end
run speech Nurse CharsNPC GenericNPCSpeech

menu OnCreate
call NurseSound.InitLoops $name
call CharAct.OnCreate $name

menu OnFreeResources
call Scrap.SetDebrisSys %Nurse.HitFile 0 0 0 1 0 0 %Fx.FXSISTPART
