# PoliceBoss (the character script chars/policeboss.py of the game): the Init that builds the action class. The format
# is described in src/game/Script/Script.c. A pack in mods/ with scrapc/chars/policeboss.menu replaces this file. The C
# gives $xbox and $level (the path of the level in capitals). The sections OnCreate ($name: the new entity) and
# OnFreeResources are the callbacks of the class.

menu PoliceBoss
call MakeChar.InitChar PoliceBoss
setvar MakeChar.MaxSpeed 1.0
setvar MakeChar.MinSpeed 0.5
call MakeChar.AddRelaxActions PoliceBoss 0
call MakeChar.AddWalkActions PoliceBoss 360 1
call MakeChar.AddFallAction PoliceBoss 45 1 0
call MakeChar.AddDazeAction PoliceBoss
call MakeChar.AddTalkAction PoliceBoss nExtraActions=3
call MakeChar.AddFlashedAction PoliceBoss
call MakeChar.AddCrazyAction PoliceBoss
call MakeChar.AddDiscover PoliceBoss
action Action
	AnmFilePath Models/Chars/PoliceBoss/Anm/PoliceBoss_Action.M3D
	isLoop 0
	RotSpeed 180
	AngRotLimit 360
	UseDisp 0
	UseFlyDisp 0
	MaxSpeed 1.0
	MinSpeed 1.0
	NodeModifier -1
	PriorityLevel 100
	AngleModifierSpeed 1.0
	UseFlyFall 0
event 0.85 PoliceBossBrup !PoliceBossBrup
event 0.93 FXPoliceBossBrup !FXPoliceBossBrup
event 1.02 FXPoliceBossBrup !FXPoliceBossBrup
event 1.13 FXPoliceBossBrup !FXPoliceBossBrup
event 1.24 FXPoliceBossBrup !FXPoliceBossBrup
event 1.36 FXPoliceBossBrup !FXPoliceBossBrup
class PoliceBoss
	WRadius 117
	VRadius 100
	SRadius 30
	YModelDisp -1
	FOV 90
	CamDist 350
	CamAng 2
	CamRot 0
	Node0Name "Bip Boss Head"
	Node1Name "Bip Boss Spine1"
call MakeChar.SetNodeRotation 0 0 25 50
call MakeChar.SetNodeRotation 0 1 25 50
class PoliceBoss
	OnCreate PoliceBoss.OnCreate
	OnFreeResources PoliceBoss.OnFreeResources
	ActionPress !PoliceBossAction
call PoliceBossSound.Init PoliceBoss
if %Init.OutMapSkip == 0
	run speech PoliceBoss CharsNPC GenericNPCSpeech
end
call Scrap.Set PoliceBossBrupBaseFile %PoliceBoss.BrupBaseFile
let base %PoliceBoss.BrupBaseFile
call Scrap.Preload3DObject $(base)A.M3D
call Scrap.SetDebrisSys $(base)A.M3D 1 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.Preload3DObject $(base)B.M3D
call Scrap.SetDebrisSys $(base)B.M3D 1 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.Preload3DObject $(base)C.M3D
call Scrap.SetDebrisSys $(base)C.M3D 1 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.Preload3DObject $(base)D.M3D
call Scrap.SetDebrisSys $(base)D.M3D 1 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.Preload3DObject $(base)E.M3D
call Scrap.SetDebrisSys $(base)E.M3D 1 0 0 1 0 0 %Fx.FXMODELFADE

menu OnCreate
call CharAct.OnCreate $name

menu OnFreeResources
let base %PoliceBoss.BrupBaseFile
call Scrap.SetDebrisSys $(base)A.M3D 0 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.SetDebrisSys $(base)B.M3D 0 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.SetDebrisSys $(base)C.M3D 0 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.SetDebrisSys $(base)D.M3D 0 0 0 1 0 0 %Fx.FXMODELFADE
call Scrap.SetDebrisSys $(base)E.M3D 0 0 0 1 0 0 %Fx.FXMODELFADE
