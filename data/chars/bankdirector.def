# BankDirector (the character script chars/bankdirector.py of the game): the Init that builds the action class. The
# format is described in src/game/Script/Script.c. A pack in mods/ with scrapc/chars/bankdirector.def replaces this
# file. The C gives $xbox and $level (the path of the level in capitals). The sections OnCreate ($name: the new entity)
# and OnFreeResources are the callbacks of the class.

section BankDirector
call MakeChar.InitChar BankDirector
setvar MakeChar.MaxSpeed 1.0
setvar MakeChar.MinSpeed 0.5
call MakeChar.AddRelaxActions BankDirector 360
call MakeChar.AddWalkActions BankDirector 360 1 1
call MakeChar.AddInitWalkActions BankDirector 360 1 1
call MakeChar.AddEndWalkActions BankDirector 360 1 1
call MakeChar.AddFallAction BankDirector 45 1 0
call MakeChar.AddDazeAction BankDirector
call MakeChar.AddTalkAction BankDirector nExtraActions=3
call MakeChar.AddFlashedAction BankDirector
call MakeChar.AddCrazyAction BankDirector
class BankDirector
	TurnAngLimit 30
	MinFallDist 25
	WRadius 125
	VRadius 95
	SRadius 20
	YModelDisp -20
	FOV 90
	CamDist 350
	CamAng -15
	CamRot 15
	Node0Name "Bip BankDirector Head"
	Node1Name "Bip BankDirector Neck1"
	Node2Name "Bip BankDirector Spine1"
call MakeChar.SetNodeRotation 0 0 5 10
call MakeChar.SetNodeRotation 0 1 10 15
call MakeChar.SetNodeRotation 0 2 25 25
class BankDirector
	CanFly 0
	FlyAccel 300.0
	FlySpeed 450.0
	FlyFric 2.0
	FlyFallAccel 4800.0
action ActionInit
	AnmFilePath Models/Chars/BankDirector/Anm/BankDirector_ActionInit.M3D
	isLoop 0
	RotSpeed 360
	MaxSpeed 1.0
	MinSpeed 1.0
	UseDisp 0
	NodeModifier 0
	PriorityLevel 101
	SlideAsFly 3
event &AnmTotalTime EndOfInit !BankDirectorEndActionInit
action Action
	AnmFilePath Models/Chars/BankDirector/Anm/BankDirector_Action.M3D
	isLoop 1
	RotSpeed 360
	MaxSpeed 1.0
	MinSpeed 1.0
	UseDisp 0
	NodeModifier 0
	PriorityLevel 100
	SlideAsFly 3
event &AnmTotalTime/4 SuckMoney !BankerAttack
action ActionEnd
	AnmFilePath Models/Chars/BankDirector/Anm/BankDirector_ActionEnd.M3D
	isLoop 0
	RotSpeed 360
	MaxSpeed 1.0
	MinSpeed 1.0
	UseDisp 0
	NodeModifier 0
	PriorityLevel 100
	SlideAsFly 3
if $level == LEVELS/GAMBLINDEN
	call MakeChar.CreateRelaxAction BankDirector 180 Dance0 Dance0
	action
		InterpTime 0.4
	call MakeChar.CreateRelaxAction BankDirector 180 Dance Dance
	action
		InterpTime 0.4
		isLoop 1
end
class BankDirector
	ActionPress !BankDirectorActionPress
	ActionRelease !BankDirectorActionRelease
	OnCreate BankDirector.OnCreate
	OnFreeResources BankDirector.OnFreeResources
call BankDirectorSound.Init BankDirector
if %Init.OutMapSkip == 0
	call Scrap.Set FXBankerStealFile %BankDirector.BankerStealFile
	call Scrap.SetDebrisSys %BankDirector.BankerStealFile 2 45000 0 1 0 0 %Fx.FXBANKERSTEAL
end
if %Init.OutMapSkip == 0
	run speech BankDirector CharsNPC GenericNPCSpeech
end

section OnCreate
call CharAct.OnCreate $name
call BankDirectorSound.InitLoops $name

section OnFreeResources
call Scrap.SetDebrisSys %BankDirector.BankerStealFile 0 45000 0 1 0 0 %Fx.FXBANKERSTEAL
