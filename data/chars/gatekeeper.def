# GateKeeper (the character script chars/gatekeeper.py of the game): the Init that builds the action class. The format
# is described in src/game/Script/Script.c. A pack in mods/ with scrapc/chars/gatekeeper.def replaces this file. The C
# gives $xbox and $level (the path of the level in capitals).

section GateKeeper
call MakeChar.InitChar GateKeeper
setvar MakeChar.MaxSpeed 1.0
setvar MakeChar.MinSpeed 1.0
call MakeChar.TurretBasicActions GateKeeper
call MakeChar.AddTurretTalkAction GateKeeper 0
call MakeChar.AddTurretTalkAct GateKeeper TalkNo 0
class GateKeeper
	WRadius 10
	VRadius 100
class GateKeeper
	CanFly 1
	FlyAccel 2400.0
	FlySpeed 500.0
	FlyFric 2.0
	FlyFallAccel 200.0
	SkipInitOnChange 0
	Node0Name "Bip GateKepeer Spine1"
	Node1Name "Bip GateKepeer Neck"
	Node2Name "Bip GateKepeer Neck1"
	Node3Name "Bip GateKepeer Neck2"
	Node4Name "Bip GateKepeer Neck3"
	Node5Name "Bip GateKepeer Neck4"
	Node6Name "Bip GateKepeer Head"
call MakeChar.SetNodeRotation 0 0 14 14
call MakeChar.SetNodeRotation 0 1 14 14
call MakeChar.SetNodeRotation 0 2 14 14
call MakeChar.SetNodeRotation 0 3 14 14
call MakeChar.SetNodeRotation 0 4 14 14
call MakeChar.SetNodeRotation 0 5 14 14
call MakeChar.SetNodeRotation 0 6 14 14
action Hide
	AnmFilePath Models/Chars/GateKeeper/Anm/GateKeeper_Hide.M3D
	isLoop 0
	RotSpeed 0
	UseDisp 0
	PriorityLevel 1
action Unhide
	AnmFilePath Models/Chars/GateKeeper/Anm/GateKeeper_Unhide.M3D
	isLoop 0
	RotSpeed 0
	UseDisp 0
	PriorityLevel 1
action Hidden
	AnmFilePath Models/Chars/GateKeeper/Anm/GateKeeper_Hidden.M3D
	isLoop 1
	RotSpeed 0
	UseDisp 0
	PriorityLevel 1
class GateKeeper
	OnCreate GateKeeper.OnCreate
call GateKeeperSound.Init GateKeeper
run speech GateKeeper GateKeeper GateKeeperSpeech
