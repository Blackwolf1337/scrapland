# Mayor (the character script chars/mayor.py of the game): the Init that builds the action class. The format is
# described in src/game/Script/Script.c. A pack in mods/ with scrapc/chars/mayor.menu replaces this file. The C gives
# $xbox and $level (the path of the level in capitals).

menu Mayor
call MakeChar.InitChar Mayor
setvar MakeChar.MaxSpeed 1.3
setvar MakeChar.MinSpeed 0.5
call MakeChar.AddRelaxActions Mayor 360
call MakeChar.AddWalkActions Mayor 360 0 1
call MakeChar.AddInitWalkActions Mayor 360 0 1
call MakeChar.AddEndWalkActions Mayor 360 0 1
call MakeChar.AddFallAction Mayor 45 1 0
call MakeChar.AddDazeAction Mayor 0
call MakeChar.AddTalkAction Mayor nExtraActions=3
call MakeChar.AddFlashedAction Mayor
call MakeChar.AddCrazyAction Mayor
call MakeChar.AddDiscover Mayor
class Mayor
	TurnAngLimit 30
	FlyAccel 400
	MinFallDist 25
	WRadius 100
	VRadius 85
	SRadius 25
	YModelDisp -5
	CanFly 0
	FlyAccel 100.0
	FlySpeed 150.0
	FlyFric 2.0
	FlyFallAccel 4800.0
	FOV 90
	CamDist 300
	CamAng 5
	CamRot 0
	Node0Name "Bip_Major Head"
	Node1Name Bip_Major
	Node2Name "Bip Patas"
call MakeChar.SetNodeRotation 0 0 40 5
call MakeChar.SetNodeRotation 0 1 0 70
call MakeChar.SetNodeRotation 0 2 0 -100
call MakeChar.SetNodeRotation 1 0 40 0
call MakeChar.SetNodeRotation 1 1 0 100
call MakeChar.SetNodeRotation 1 2 0 -100
action ActionInit
	AnmFilePath Models/Chars/Mayor/Anm/Mayor_ActionInit.M3D
	isLoop 0
	RotSpeed 360
	MaxSpeed 1.0
	MinSpeed 1.0
	UseDisp 0
	NodeModifier 1
	PriorityLevel 100
	SlideAsFly 1
action Action
	AnmFilePath Models/Chars/Mayor/Anm/Mayor_Action.M3D
	isLoop 1
	RotSpeed 360
	MaxSpeed 1.0
	MinSpeed 1.0
	UseDisp 0
	NodeModifier 1
	PriorityLevel 101
	SlideAsFly 1
event &TimeOfFrame59 EndOfAction !MayorEndAction
event &TimeOfFrame125 EndOfAction !MayorEndAction
event &TimeOfFrame160 EndOfAction !MayorEndAction
event &AnmTotalTime*1.5 EndOfAction !MayorEndAction
event &TimeOfFrame7 FXCharacterBlaBliBla1 !FXCharacterBlaBliBla
event &TimeOfFrame15 FXCharacterBlaBliBla2 !FXCharacterBlaBliBla
event &TimeOfFrame28 FXCharacterBlaBliBla3 !FXCharacterBlaBliBla
event &TimeOfFrame43 FXCharacterBlaBliBla4 !FXCharacterBlaBliBla
event &TimeOfFrame55 FXCharacterBlaBliBla5 !FXCharacterBlaBliBla
event &TimeOfFrame75 FXCharacterBlaBliBla6 !FXCharacterBlaBliBla
event &TimeOfFrame95 FXCharacterBlaBliBla7 !FXCharacterBlaBliBla
event &TimeOfFrame108 FXCharacterBlaBliBla8 !FXCharacterBlaBliBla
event &TimeOfFrame118 FXCharacterBlaBliBla9 !FXCharacterBlaBliBla
event &TimeOfFrame132 FXCharacterBlaBliBla10 !FXCharacterBlaBliBla
event &TimeOfFrame150 FXCharacterBlaBliBla11 !FXCharacterBlaBliBla
event &TimeOfFrame162 FXCharacterBlaBliBla12 !FXCharacterBlaBliBla
action ActionEnd
	AnmFilePath Models/Chars/Mayor/Anm/Mayor_ActionEnd.M3D
	isLoop 0
	RotSpeed 360
	MaxSpeed 1.0
	MinSpeed 1.0
	UseDisp 0
	NodeModifier 1
	PriorityLevel 102
	SlideAsFly 1
event &AnmTotalTime*1.5 MayorReCheckAction Mayor.MayorReCheckAction
class Mayor
	OnCreate Mayor.OnCreate
	ActionPress Mayor.MayorActionPress
call MayorSound.Init Mayor
if %Init.OutMapSkip == 0
	run speech Mayor CharsNPC GenericNPCSpeech
end
