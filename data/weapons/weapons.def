call Scrap.SetDebrisSys %Inferno.ExplosionFile 1 0 0 1 0 0 %Fx.FXINFERNOEXPLOSION
call SNet.AddResource %Inferno.NetResName

section Inferno
call SWeap.SetSWeap $idWeap "Name" "Inferno"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call SWeap.SetFWeap $idWeap "Upgrd11" 1
call SWeap.SetFWeap $idWeap "Upgrd12" 1
call SWeap.SetFWeap $idWeap "MinAmmo" 124
call Scrap.Set "InfernoIDWeap" $idWeap
call Scrap.GetNetFlags
call SWeap.SetSWeap $idWeap "OnEnd" "!InfernoOnEnd"
call SWeap.SetSWeap $idWeap "OnStart" "!InfernoOnStart"
if $server
	call SWeap.SetSWeap $idWeap "OnFire" "!InfernoClientFire"
	call SWeap.SetSWeap $idWeap "OnPress" "!InfernoPress"
	call SWeap.SetSWeap $idWeap "OnRelease" "!InfernoRelease"
else
	call SWeap.SetSWeap $idWeap "OnPress" "!InfernoPress"
	call SWeap.SetSWeap $idWeap "OnRelease" "!InfernoRelease"
	call SWeap.SetSWeap $idWeap "OnFire" "!InfernoFire"
end
call SWeap.SetSWeap $idWeap "SetFX" "!InfernoFX"
run print "Inferno loaded!"

section CloudRes
call Scrap.Set "CloudFile" %Cloud.CloudFile
call Scrap.SetDebrisSys %Cloud.CloudFile 2 0 0 1 0 0 %Fx.FXDEBRISCLOUD
call SNet.AddResource %Cloud.NetResName

section Cloud
call Scrap.Set "CloudIDAmmo" $idAmmo
call Scrap.Set "CloudAmmoNeed" %Cloud.AmmoNeed
call Scrap.Set "CloudRechargeTime" -1.5
call Scrap.Set "CloudLifeTime" %Cloud.LifeTime
call Scrap.Set "CreateCloudFunc" "Cloud.CreateCloud"
call Scrap.Set "SetUpCloudFunc" "Cloud.SetUpCloud"
call SWeap.SetSAmmo $idAmmo "OnFire" "!CloudFire"
run print "Cloud loaded!"

