section ATPCRes
call Scrap.Set "ATPCShootFile" %ATPC.ShootFile
call Scrap.SetDebrisSys %ATPC.ShootFile 3 0 0 1 0 0 %Fx.FXATPC

section ATPC
call SWeap.SetSWeap $idWeap "Name" "ATPC"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call SWeap.SetFWeap $idWeap "Upgrd09" 1
call SWeap.SetFWeap $idWeap "Upgrd10" 1
call Scrap.GetNetFlags
call Scrap.Set "ATPCIDWeap" $idWeap
call Scrap.Set "ATPCIDAmmo" $idAmmo
call Scrap.Set "ATPCHitForce" 10000
call Scrap.Set "ATPCRange" 100000
call Scrap.Set "ATPCAmmoCost" 10.0
call Scrap.Set "ATPCDelay" 2.0
call Scrap.Set "ATPCUpgradeDelay" 1.0
call Scrap.Set "ATPCConvDist" 2000.0
call Scrap.Set "ATPCExplosionRadius" 1000.0
call Scrap.Set "ATPCMainDamage" 18
call Scrap.Set "ATPCExtraDamage" 7
call SWeap.SetSWeap $idWeap "OnEnd" "!ATPCOnEnd"
call SWeap.SetSWeap $idWeap "OnStart" "!ATPCOnStart"
call SWeap.SetSWeap $idWeap "OnHit" "!ATPCCreate"
