section LaserRes
call Scrap.Set "LaserShootFile" %Laser.ShootFile
call Scrap.SetDebrisSys %Laser.ShootFile 4 0 0 1 0 0 %Fx.FXLASER
call Scrap.Set "LaserHitFile" %Laser.HitFile
call Scrap.SetDebrisSys %Laser.HitFile 1 0 0 1 0 0 %Fx.FXSISTPART
call Scrap.Set "LaserHookFile" %Laser.HookFile
call Scrap.SetDebrisSys %Laser.HookFile 6 0 0 1 0 0 %Fx.FXHOOK
call Scrap.Set "LaserHookSparksFile" %Laser.HookSparksFile
call Scrap.SetDebrisSys %Laser.HookSparksFile 1 0 0 1 0 0 %Fx.FXSPARKS

section Laser
call SWeap.SetSWeap $idWeap "Name" "Laser"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call Scrap.GetNetFlags
call Scrap.Set "LaserIDWeap" $idWeap
call Scrap.Set "LaserIDAmmo" $idAmmo
call Scrap.Set "LaserHitForce" %Laser.HitForce
call Scrap.Set "LaserRange" 30000
call Scrap.Set "LaserDistLimit" 20000
call Scrap.Set "LaserAmmoCost" 10.0
call Scrap.Set "LaserTimeDelay" 0.2
call Scrap.Set "HookRange" 20000.0
call Scrap.Set "HookAccel" 20000.0
call Scrap.Set "HookPlugFunc" "!HookPlugFX"
call SWeap.SetSWeap $idWeap "OnPress" "!LaserPress"
call SWeap.SetSWeap $idWeap "OnRelease" "!LaserRelease"
call SWeap.SetSWeap $idWeap "OnHit" "!LaserCreate"
call SWeap.SetSWeap $idWeap "OnFire" "!LaserFire"
call SWeap.SetSWeap $idWeap "SetFX" "!LaserFX"
call SWeap.SetSAmmo $idAmmo "OnFire" "!HookFire"
call SWeap.SetSAmmo $idAmmo "OnPress" "!HookActivate"
call SWeap.SetSAmmo $idAmmo "OnRelease" "!HookDeActivate"
run print "Laser loaded!"

section SwarmRes
call Scrap.Preload3DObject %Swarm.MissileFile
call Scrap.Set "SwarmMissileFile" %Swarm.MissileFile
call Scrap.SetDebrisSys %Swarm.MissileFile 32 50000 0 1 0 0 %Fx.FXSWARMMISSILE
call Scrap.Set "SwarmExplosionFile" %Swarm.ExplosionFile
call Scrap.SetDebrisSys %Swarm.ExplosionFile 3 50000 0 1 0 0 %Fx.FXSISTPART
call Scrap.Set "SwarmBeeExplosionFile" %Swarm.BeeExplosionFile
call Scrap.SetDebrisSys %Swarm.BeeExplosionFile 1 0 0 1 0 0 %Fx.FXSISTPART
call SNet.AddResource %Swarm.NetResName

section Swarm
call Scrap.Set "SwarmTurnSpeed" 60
call Scrap.Set "SwarmTurnSpeedUPG" 100
call SWeap.SetSWeap $idWeap "Name" "Swarm"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call SWeap.SetFWeap $idWeap "Upgrd03" 1
call SWeap.SetFWeap $idWeap "Upgrd04" 1
call Scrap.Set "SwarmIDWeap" $idWeap
call Scrap.GetNetFlags
call SWeap.SetSWeap $idWeap "OnEnd" "!SwarmOnEnd"
call SWeap.SetSWeap $idWeap "OnStart" "!SwarmOnStart"
if $server
	call SWeap.SetSWeap $idWeap "OnFire" "!SwarmClientFire"
	call SWeap.SetSWeap $idWeap "OnPress" "!SwarmPress"
	call SWeap.SetSWeap $idWeap "OnRelease" "!SwarmRelease"
else
	call SWeap.SetSWeap $idWeap "OnPress" "!SwarmPress"
	call SWeap.SetSWeap $idWeap "OnRelease" "!SwarmRelease"
	call SWeap.SetSWeap $idWeap "OnFire" "!SwarmFire"
end
call SWeap.SetSWeap $idWeap "SetFX" "!SwarmFX"
run print "Swarm loaded!"

