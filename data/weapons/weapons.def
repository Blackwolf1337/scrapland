# The weapons of the outdoor levels (the scripts weapons/*.py of the game): the ammo types (section Ammo), the weapon
# list (section Weapons), and per weapon module its resources (<Module>Res, the script's LoadResources) and its
# settings (<Module>, the rest of Init). $idWeap and $idAmmo are the arguments of Init; Swarm and Inferno get $server
# (the first net flag), the C (src/game/Script/Weapons.c) does the net hooks and the module variables IDWeap/IDAmmo.
# File names, forces and times that are variables of a module are read from it (%Vulcan.BulletFile).
# A pack in mods/ with scrapc/weapons/weapons.def replaces this file.

section Ammo
call SWeap.InitAmmo 4
call SWeap.SetSAmmo 0 "Name" "Particle"
call SWeap.SetFAmmo 0 "Charger" 0.0
call SWeap.SetFAmmo 0 "Max" 1000.0
call SWeap.SetSAmmo 1 "Name" "Missile"
call SWeap.SetFAmmo 1 "Charger" 0.0
call SWeap.SetFAmmo 1 "Max" 500.0
call SWeap.SetSAmmo 2 "Name" "Energy"
call SWeap.SetFAmmo 2 "Charger" 0.0
call SWeap.SetFAmmo 2 "Max" 1500.0
call SWeap.SetSAmmo 3 "Name" "Photon"
call SWeap.SetFAmmo 3 "Charger" 20.0
call SWeap.SetFAmmo 3 "Max" 200.0

section Weapons
run print "Creating Weapons..."
call SWeap.InitWeap 7
call Vulcan.Init 0 0
call Devastator.Init 3 0
call Cloud.Init 0
call Swarm.Init 1 1
call Inferno.Init 5 1
call Sonic.Init 1
call Tesla.Init 2 2
call ATPC.Init 4 2
call EMI.Init 2
call Laser.Init 6 3
call SWeap.FillPriority
call Scrap.GetNetFlags
run print "Weapon.Init() executed."

section VulcanRes
call Scrap.Set "VulcanBulletFile" %Vulcan.BulletFile
call Scrap.SetDebrisSys %Vulcan.BulletFile 20 10000 1 0.7 9800 1
call Scrap.Set "VulcanHitFile" %Vulcan.HitFile
call Scrap.SetDebrisSys %Vulcan.HitFile 1 0 0 1 0 0 %Fx.FXSISTPART

section Vulcan
call SWeap.SetSWeap $idWeap "Name" "Vulcan"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call SWeap.SetFWeap $idWeap "Upgrd01" 1
call SWeap.SetFWeap $idWeap "Upgrd02" 1
call Scrap.GetNetFlags
call Scrap.Set "VulcanIDWeap" $idWeap
call Scrap.Set "VulcanIDAmmo" $idAmmo
call Scrap.Set "VulcanHitForce" %Vulcan.HitForce
call Scrap.Set "VulcanRange" 40000
call Scrap.Set "VulcanDistLimit" 26666
call Scrap.Set "VulcanDistLimitUPG" 40000
call Scrap.Set "VulcanAmmoCost" 0.5
call Scrap.Set "VulcanTimeDelay" 0.1
call Scrap.Set "VulcanTimeDelayUPG" 0.075
call SWeap.SetSWeap $idWeap "OnPress" "!VulcanPress"
call SWeap.SetSWeap $idWeap "OnRelease" "!VulcanRelease"
call SWeap.SetSWeap $idWeap "OnHit" "!VulcanCreate"
call SWeap.SetSWeap $idWeap "OnFire" "!VulcanFire"
call SWeap.SetSWeap $idWeap "SetFX" "!VulcanFX"
run print "Vulcan loaded!"

section DevastatorRes
call Scrap.Set "DevastatorBulletFile" %Devastator.BulletFile
call Scrap.SetDebrisSys %Devastator.BulletFile 10 10000 1 0.7 9800 1
call Scrap.Set "DevastatorHitFile" %Devastator.HitFile
call Scrap.SetDebrisSys %Devastator.HitFile 1 0 0 1 0 0 %Fx.FXSISTPART
call Scrap.Set "DevastatorSparksFile" %Devastator.SparksFile
call Scrap.SetDebrisSys %Devastator.SparksFile 1 0 0 1 0 0 %Fx.FXSPARKS
call Scrap.Set "DevastatorShootFile" %Devastator.ShootFile
call Scrap.SetDebrisSys %Devastator.ShootFile 6 0 0 1 0 0 %Fx.FXDEVASTATORSHOOT

section Devastator
call SWeap.SetSWeap $idWeap "Name" "Devastator"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call SWeap.SetFWeap $idWeap "Upgrd07" 1
call SWeap.SetFWeap $idWeap "Upgrd08" 1
call Scrap.GetNetFlags
call Scrap.Set "DevastatorIDWeap" $idWeap
call Scrap.Set "DevastatorIDAmmo" $idAmmo
call Scrap.Set "DevastatorHitForce" 12000
call Scrap.Set "DevastatorRange" 40000
call Scrap.Set "DevastatorDistLimit" 40000
call Scrap.Set "DevastatorAmmoCost" 1.0
call Scrap.Set "DevastatorSpreadAngle" 3.5
call Scrap.Set "DevastatorRechargeTime" 0.25
call Scrap.Set "DevastatorExplosionRadius" 1500.0
call Scrap.Set "DevastatorMinDamage" 2.0
call Scrap.Set "DevastatorExtraDamage" 5.0
call SWeap.SetSWeap $idWeap "OnPress" "!DevastatorPress"
call SWeap.SetSWeap $idWeap "OnRelease" "!DevastatorRelease"
call SWeap.SetSWeap $idWeap "OnHit" "!DevastatorCreate"
call SWeap.SetSWeap $idWeap "OnFire" "!DevastatorFire"
call SWeap.SetSWeap $idWeap "SetFX" "!DevastatorFX"
run print "Devastator loaded!"

section TeslaRes
call Scrap.Set "TeslaShootFile" %Tesla.ShootFile
call Scrap.SetDebrisSys %Tesla.ShootFile 3 0 0 1 0 0 %Fx.FXTESLA

section Tesla
call SWeap.SetSWeap $idWeap "Name" "Tesla"
call SWeap.SetFWeap $idWeap "iAmmo" $idAmmo
call SWeap.SetFWeap $idWeap "Upgrd05" 1
call SWeap.SetFWeap $idWeap "Upgrd06" 1
call Scrap.GetNetFlags
call Scrap.Set "TeslaIDWeap" $idWeap
call Scrap.Set "TeslaIDAmmo" $idAmmo
call Scrap.Set "TeslaHitForce" 500000
call Scrap.Set "TeslaTrackForce" 20000
call Scrap.Set "TeslaRange" 20000
call Scrap.Set "TeslaDistLimit" 20000
call Scrap.Set "TeslaMinAngRange" 5
call Scrap.Set "TeslaMinAngRangeUpg" 12
call Scrap.Set "TeslaMaxAngRange" 25
call Scrap.Set "TeslaDownRangeTime" 0.5
call Scrap.Set "TeslaUpRangeTime" 0.25
call Scrap.Set "TeslaAmmoCost" 0.3
