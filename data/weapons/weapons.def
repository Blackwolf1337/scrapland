section SonicRes
call Scrap.Preload3DObject %Sonic.MineFile
call Scrap.Set "FXSonicXpldeFile" %Sonic.SonicXpldeFile
call Scrap.SetDebrisSys %Sonic.SonicXpldeFile 2 0 0 1 0 0 %Fx.FXSONICEXPLOSION
call SNet.AddResource %Sonic.NetResName

section Sonic
call Scrap.Set "SonicIDAmmo" $idAmmo
call Scrap.Set "SonicRechargeTime" -0.75
call Scrap.Set "SonicAmmoNeed" 2
call Scrap.Set "SonicLifeTime" %Sonic.LifeTime
call Scrap.Set "SonicArmor" 25
call Scrap.Set "CreateSonicFunc" "Sonic.CreateSonic"
call Scrap.Set "SetUpSonicFunc" "Sonic.SetUpSonic"
call Scrap.Set "FXSonicRadius" %Sonic.FXSonicRadius
call SWeap.SetSAmmo $idAmmo "OnFire" "!SonicFire"
run print "Sonic loaded!"
