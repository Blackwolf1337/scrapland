call SWeap.SetSWeap $idWeap "OnPress" "!TeslaPress"
call SWeap.SetSWeap $idWeap "OnRelease" "!TeslaRelease"
call SWeap.SetSWeap $idWeap "OnHit" "!TeslaCreate"
call SWeap.SetSWeap $idWeap "OnFire" "!TeslaFire"
