# The functions of MapSnd in level commercial (the script levels/commercial/scripts/mapsnd.py of data02.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/commercial/mapsnd.def replaces this file.
section LoadSounds
if %MapSnd.isPC
	call SSound.LoadSound "holograma2.wav"
	call SSound.LoadSound "ventilador3.wav"
	call SSound.LoadSound "HologramBuzz2.wav"
	call SSound.LoadSound "light1.wav"
end
call SSound.LoadSound "tunel334.wav"
if %MapSnd.isPC
	call SSound.LoadSound "maquina-commer.wav"
	call SSound.LoadSound "transformer3-commer.wav"
	call SSound.LoadSound "buble-commer.wav"
	call SSound.LoadSound "rueda-commer.wav"
end

section SndElements Name x y z angx angy
setvar MapSnd.cntr %MapSnd.cntr+1
if $Name == "ComerHolo01"
	if %MapSnd.isPC
		let _cntr %MapSnd.cntr
		call Sound.SetPSLoop "$(Name)$(_cntr)" ($x,$y,$z) "holograma2" 0.5
		let _cntr %MapSnd.cntr
		call Sound.SetPSInterval "I$(Name)$(_cntr)" ($x,$y,$z) "HologramBuzz2" 0 2 0.15 0
end
elif $Name == "ComerHolo02"
	if %MapSnd.isPC
