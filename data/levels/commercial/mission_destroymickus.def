# The functions of Mission_DestroyMickus in level commercial (the script levels/commercial/scripts/mission_destroymickus.py of data02.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: GetFuncEnemiesProfile, InitStatus, Init, CreateTransports, InitMission, OnMickusDamage, ScanShip, CheckContinueScanning, ResetScan, OnFinishScan, MickusIdentified, ReassignTarget, TraitoriusFuncEnemiesCom, CheckMickusVisibility, CreateFuncEnemies, OnFuncEnemiesDeath, OnTransportsDeath, DropMoney, TakeMoney, MissionScorer.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/commercial/mission_destroymickus.def replaces this file.
section StopMission
setvar Menu.MissionScorerCall None
call Scrap.DeleteScheduledFuncs "ScanShip"

section ResetScan2
call SScorer.Set 0 "ScanRemainingTime" "Blink" 0
call SScorer.Set 0 "ScanRemainingTime" "MaxValue" %Mission_DestroyMickus.MAX_SCANNING_TIME
call SScorer.Set 0 "ScanRemainingTime" "Value" %Mission_DestroyMickus.MAX_SCANNING_TIME

section SetNextMission
call Scrap.DelSaveVars "MissionState"
call Scrap.DelSaveVars "NumTransports"
call MissionsFuncs.SetNextMission "Mission_ArrangeBankersCTF" "GamblinDen"
call SaveGame.MMDesc "Mission_TalkToTraitorius3_MissionText1" 1
call Scrap.SetSaveVar "MayorAtTownHall" "1"
call Scrap.SetSaveVar "BankMasterAtBank" "1"
call Scrap.SetSaveVar "Journalist.Humphrey_Defaut" "Press"
call Scrap.SetSaveVar "Journalist.Betty_Defaut" "GamblinDen"
call Scrap.SetSaveVar "Journalist.Berto_Defaut" "GamblinDen"
call SaveGame.QWayPoint
