# The functions of Mission_Win1stRace in level commercial (the script levels/commercial/scripts/mission_win1strace.py of data02.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: InitStatus, Init, InitTimeRace, OnRaceStart, RaceGo, OnCheckPoint, OnAlarmOn, TimeExpired, MissionScorer.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/commercial/mission_win1strace.def replaces this file.
section OnAlarmOff
setvar Alarm.TempAbortMissionCallback %Mission_Win1stRace.OnAlarmOn
call Speech.AddRemoteCom "Mission_Win1stRace_RemoteMessage3" "Trurl" %Mission_Win1stRace.InitTimeRace ()

section PreSetNextMission
call Scrap.Set "isActionMusic" 0
setvar Alarm.TempAbortMissionCallback None
setvar Alarm.TempRestoreMissionCallback None
call Speech.AddRemoteCom "Mission_Win1stRace_RemoteMessage4" "Trurl" %Mission_Win1stRace.SetNextMission ()

section SetNextMission
call Scrap.DelSaveVars "MissionState"
call MissionsFuncs.SetNextMission "Mission_Win2ndRace" "Outskirts"
call SaveGame.MMDesc "Mission_Win2ndRace_MissionText1" 1
call SaveGame.QWayPoint
