# The functions of Mission_DefeatCrazyGambler3 in level commercial (the script levels/commercial/scripts/mission_defeatcrazygambler3.py of data02.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: GetCrazyGamblerProfile, InitStatus, Init, LaunchFirstTaunt, LaunchTaunts, RefreshScorer, CreateCrazyGambler, CreateCrazyGamblers, OnCrazyGamblerDeath, AfterDeepThroatMessage, DropBossMatrix, TakeMatrix, MissionScorer.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/commercial/mission_defeatcrazygambler3.def replaces this file.
section SetNextMission
call Scrap.DelSaveVars "NumCrazyGamblerLifes"
call MissionsFuncs.SetNextMission "Mission_WhoIsDeepThroat" "Press"
call SaveGame.MMDesc "Mission_WhoIsDeepThroat_MissionText1" 1
call Scrap.SetSaveVar "Journalist.Humphrey_Defaut" "Press"
call Scrap.SetSaveVar "Journalist.Betty_Defaut" "Press"
call Scrap.SetSaveVar "Journalist.Berto_Defaut" "Press"
call SaveGame.QWayPoint
