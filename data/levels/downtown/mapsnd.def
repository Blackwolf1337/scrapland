# The functions of MapSnd in level downtown (the script levels/downtown/scripts/mapsnd.py of Data.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: SndElements.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/downtown/mapsnd.def replaces this file.
section LoadSounds
if %MapSnd.isPC
	call SSound.LoadSound "light1.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "holograma2.wav"
end
call SSound.LoadSound "tunel334.wav"
if %MapSnd.isPC
	call SSound.LoadSound "humo.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "maquina2-quimera.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "aire2-quimera.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "tube1-quimera.wav"
end

