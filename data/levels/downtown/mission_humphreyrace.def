# The functions of Mission_HumphreyRace in level downtown (the script levels/downtown/scripts/mission_humphreyrace.py of Data.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script are C (src/game/Script/levels/DownTown.c): InitStatus, ShowSystemMessage, Init, ShowBoostMessage, ClosePressHangar, DelRacers, CallCrazyGambler, UsePhoneCab, PreGivePlans2, GivePlans, SetNextMission.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/downtown/mission_humphreyrace.def replaces this file.
section OnTryingToExit UsrName MetroName optId FullOption
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage12" "Humphrey"

section SetMissionTarget name
call MissionsFuncs.SetMissionTarget $name

section OnPlayerLoosesRace
call MissionsFuncs.SetMissionTarget None
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage6" "CrazyGambler"

section OnPlayerWinsRace
setvar RaceMaker.OnPlayerWinsRace None
setvar RaceMaker.OnPlayerLoosesRace None
setvar RaceMaker.OnPreInitRace None
setvar RaceMaker.OnInitRace None
call MissionsFuncs.SetMissionTarget None
call Scrap.SetSaveVar "Stats.WinHumphreyRace" "1"
call Scrap.SetSaveVar "MissionState" "CallCrazyGambler"
call Scrap.SetSaveVar "Revenge.Type" ""
call Scrap.SetSaveVar "Revenge.Foe" ""
call Scrap.SetSaveVar "Revenge.NumEnemies" ""
call Scrap.SetSaveVar "Player.InfiniteLives" "0"
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage7" "CrazyGambler" %Mission_HumphreyRace.CallCrazyGambler ()
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage8" "Bishop"

section PreGivePlans
call Scorer.ShowMissionScorer 0 1
setvar Speech.OnOutOfRange None
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage11" "Boss" %Mission_HumphreyRace.PreGivePlans2 ()
