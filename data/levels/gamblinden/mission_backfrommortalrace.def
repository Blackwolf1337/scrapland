# The functions of Mission_BackFromMortalRace in level gamblinden (the script levels/gamblinden/scripts/mission_backfrommortalrace.py of data03.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: Init, AfterDeepThroatMessageShown.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/gamblinden/mission_backfrommortalrace.def replaces this file.
section InitStatus LevelPath
call Scrap.SetSaveVar "FunctionaryTwinsAtGambinDen" "1"
call Scrap.SetSaveVar "BankersAtGambinDen" "0"
call Scrap.SetSaveVar "BishopsAtGambinDen" "0"
call Scrap.SetSaveVar "PolicesAtGambinDen" "1"

section TalkToDeepThroat
call Speech.AddRemoteCom "Mission_WinMortalRace_RemoteMessage4" "DeepThroat" %Mission_BackFromMortalRace.AfterDeepThroatMessageShown

section DeepThroatSpeech UsrName CharName optId FullOption
setvar Speech.PlayerName $UsrName
setvar Speech.NPCName $CharName
setvar Speech.OnEndOfSpeech %Mission_BackFromMortalRace.SetNextMission
setvar Speech.OnEndOfSpeechParams ()
call Speech.NISpeech "DeepThroat"
call Speech.AutoAddNI "Mission_TalkToDeepThroat10_ComDeepThroat_NI_1Msg"
call Speech.RunNI

section SetNextMission
setvar DTritusDesktop.DialogController None
call MissionsFuncs.ActivateTarget %Mission_BackFromMortalRace.dd 0
call SaveGame.QWayPoint
call MissionsFuncs.SetNextMission "Mission_DestroyBadDebtors" "Outskirts"
call SaveGame.MMDesc "Mission_MeetBankMaster_MissionText1" 1
