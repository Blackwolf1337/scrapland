# The functions of Mission_ArrangeBankersCombat in level gamblinden (the script levels/gamblinden/scripts/mission_arrangebankerscombat.py of data03.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: InitStatus, Init, LaunchIgorDefeatedSpeech, LaunchDeepThroatMessage, TalkToPoliceBoss, TalkToCrazyGambler, CrazyGamblerSpeech.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/gamblinden/mission_arrangebankerscombat.def replaces this file.
section TalkToDeepThroat
call MissionsFuncs.ActivateTarget %Mission_ArrangeBankersCombat.dd 1
call SaveGame.QWayPoint
call SaveGame.MMDesc "Mission_CallDeepThroat2_MissionText1" 1
setvar DTritusDesktop.DialogController %Mission_ArrangeBankersCombat.DeepThroatSpeech

section DeepThroatSpeech UsrName CharName optId FullOption
call MissionsFuncs.ActivateTarget %Mission_ArrangeBankersCombat.dd 0
setvar Speech.PlayerName $UsrName
setvar Speech.NPCName $CharName
setvar Speech.OnEndOfSpeech %Mission_ArrangeBankersCombat.TalkToPoliceBoss
setvar Speech.OnEndOfSpeechParams ()
call Scrap.SetSaveVar "Mission_ArrangeBankersCombat" "Police"
call Speech.NISpeech "DeepThroat"
call Speech.AutoAddNI "Mission_CallDeepThroat2_ComDeepThroat_NI_1Msg"
call Speech.RunNI

section PoliceBossSpeech UsrName CharName optId FullOption
setvar Speech.PlayerName $UsrName
setvar Speech.NPCName $CharName
if $optId == "Talk"
	setvar Speech.OnEndOfSpeech %Mission_ArrangeBankersCombat.TalkToCrazyGambler
	setvar Speech.OnEndOfSpeechParams ()
	call Speech.NISpeech "PoliceBoss"
	call Speech.AutoAddNI "Mission_SpyPoliceBoss_PoliceBoss_NI_1Msg"
	call Speech.RunNI
	call Scrap.SetSaveVar "Mission_ArrangeBankersCombat" "Crazy"
else
	call Speech.StdOnSpch $optId
end

section PoliceBossSpeech2 UsrName CharName optId FullOption
setvar Speech.PlayerName $UsrName
setvar Speech.NPCName $CharName
if $optId == "Talk"
	call Speech.OnSpch "Mission_ArrangeBankersCombat_PoliceBoss_InitMsg1" "Mission_ArrangeBankersCombat_PoliceBoss_InitAns1"
end

section LaunchBankersCombat
call Scrap.DelSaveVars "Mission_ArrangeBankersCombat"
call SaveGame.MMDesc "Mission_GetBankerShipPlans_MissionText1" 1
call MissionsFuncs.StartSuperDeal "QF" "Mission_BankersCombat" "TeamDeathMatch"
