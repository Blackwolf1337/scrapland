# The functions of SuperDeal_Sixth in level om (the script levels/om/scripts/superdeal_sixth.py of data01.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script are C (src/game/Script/levels/OM.c): SetVars.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/om/superdeal_sixth.def replaces this file.
section InitStatus LevelPath
call SuperDeal_Sixth.SetVars

section Init LevelPath

section Victory
run savelistadd "Hangar.availableUpgradesList" "ATPCUpgrade2"
call Scrap.IncSaveVar "NewBluePrintAvaliable"
call MissionsFuncs.NewCrazyDeal 1 "Stats.Treasure" 3
call MissionsFuncs.NewCrazyDeal 2 "Stats.Mosquito" 50
call MissionsFuncs.NewCrazyDeal 3 "Stats.Bishop" 10
call MissionsFuncs.SetNextSuperDeal "FZ" "SuperDeal_Seventh" "MortalRace"
call MissionsFuncs.EndOfSuperDeal "SuperDeal_Sixth_SystemMessage1"
call Scrap.SetSaveVar "PlayerRounds" "0"
call Scrap.SetSaveVar "EnemyRounds" "0"
call Scrap.Achievement 9
