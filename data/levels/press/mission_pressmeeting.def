call Scrap.SetSaveVar "Journalist.Humphrey_Defaut" "Press"
call Scrap.SetSaveVar "Spawn" "DM_Player_Spawn_Press"
call Scrap.SetSaveVar "ComeFrom" ""

section Init LevelPath
call Mission_PressMeeting.LoadScene
call Scene.Play "News2"
call Scrap.Set "isActionIndoor" 0
call SSound.SetMusicVolume 0
call SSound.UsePS 0
setvar Scene.EndOfSceneCallback %Mission_PressMeeting.SetNextMission

