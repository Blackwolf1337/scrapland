# The functions of Mission_HumphreyArchbishopKilled in level press (the script levels/press/scripts/mission_humphreyarchbishopkilled.py of data01.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: SetNextMission, CGCalls, LoadScene.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/press/mission_humphreyarchbishopkilled.def replaces this file.
section InitStatus LevelPath
call Scrap.SetSaveVar "Spawn" "DM_Player_Spawn_Press"
call Scrap.SetSaveVar "ComeFrom" ""

section Init LevelPath
call Mission_HumphreyArchbishopKilled.LoadScene
call Scene.Play "News1"
call SSound.UsePS 0
setvar Scene.EndOfSceneCallback %Mission_HumphreyArchbishopKilled.SetNextMission
call Scrap.Set "isActionIndoor" 0
call SSound.SetMusicVolume 0
