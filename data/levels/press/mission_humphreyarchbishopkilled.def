# The functions of Mission_HumphreyArchbishopKilled in level press (the script levels/press/scripts/mission_humphreyarchbishopkilled.py of data01.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: SetNextMission, CGCalls.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/press/mission_humphreyarchbishopkilled.def replaces this file.
section InitStatus LevelPath
call Scrap.SetSaveVar "Spawn" "DM_Player_Spawn_Press"
call Scrap.SetSaveVar "ComeFrom" ""

section Init LevelPath
call Mission_HumphreyArchbishopKilled.LoadScene
call Scene.Play "News1"
call SSound.UsePS 0
setvar Scene.EndOfSceneCallback %Mission_HumphreyArchbishopKilled.SetNextMission
call Scrap.Set "isActionIndoor" 0
call SSound.SetMusicVolume 0

section LoadScene
call Scene.Load "News1"
call Scene.ActorAction 0 "Betty" "TV-Relax"
call Scene.ActorAction 140 "Betty" "MorphLips"
call Scene.ActorAction 140 "Betty" "TV-Talk"
call Scene.ActorAction 200 "Betty" "TV-Talk0"
call Scene.ActorAction 250 "Betty" "TV-Talk"
call Scene.ActorAction 345 "Betty" "TV-Boton"
call Scene.ActorAction 455 "Betty" "TV-Talk"
call Scene.ActorAction 520 "Betty" "TV-Talk"
call Scene.ActorAction 750 "Betty" "TV-Talk1"
call Scene.ActorAction 810 "Betty" "TV-Talk"
call Scene.ActorBreakChannel 865 "Betty" 3
call Scene.ActorAction 855 "Betty" "TV-Relax"
call Scene.ActorAction 0 "Dtritus" "Relax"
call Scene.ActorAction 960 "Dtritus" "Turn"
call Scene.ActorAction 980 "Dtritus" "Relax"
call Scene.ActorAction 1085 "Dtritus" "Talk3"
call Scene.ActorAction 1135 "Dtritus" "Relax"
call Scene.ActorAction 1210 "Dtritus" "Listen"
call Scene.ActorAction 1310 "Dtritus" "Relax"
call Scene.ActorAction 0 "Humphrey" "Relax"
call Scene.ActorAction 940 "Humphrey" "Turn"
call Scene.ActorAction 960 "Humphrey" "Talk"
call Scene.ActorAction 1065 "Humphrey" "Relax"
call Scene.ActorAction 1155 "Humphrey" "Talk"
call Scene.ActorAction 1210 "Humphrey" "Talk0"
call Scene.ActorAction 1265 "Humphrey" "Talk"
call Scene.ActorAction 1310 "Humphrey" "Talk1"
call Scene.ActorAction 1360 "Humphrey" "Relax"
call Scene.ActorAction 0 "Cabecera" "Relax"
call Scene.ActorAction 0 "Screenshot1" "Relax"
call Scene.ActorAction 0 "Final" "Relax"
call Scene.ActorAction 0 "Portatil" "Relax"
call Scene.AddGeneric 890 "SSound.UsePS(1)"
call Scene.AddGeneric 1385 "SScorer.Fade(0,(0,0,0,0),(0,0,0,255),0.5)"
call Scene.AddText 140 "News_1stMurder_RemoteMessage1" 26
call Scene.AddText 960 "Mission_Scene_ArchbishopKilled_Photo_1" 6
call Scene.AddText 1085 "Mission_Scene_ArchbishopKilled_Photo_2" 3
call Scene.AddText 1155 "Mission_Scene_ArchbishopKilled_Photo_3" 8
call Scrap.Set "DefInterpTime" 1.0
let CharType "Betty"
call Scene.AddCharActor "Betty" $CharType
call Scene.CreateLocalAction $CharType 0 "TV-Relax" "TV-Relax" 1
call Scene.CreateLocalAction $CharType 0 "TV-Talk" "TV-Talk" 1
call Scene.CreateLocalAction $CharType 0 "TV-Talk0" "TV-Talk0" 1
call Scene.CreateLocalAction $CharType 0 "TV-Talk1" "TV-Talk1" 1
call Scene.CreateLocalAction $CharType 0 "TV-Boton" "TV-Boton" 1
call Scene.CreateLocalAction $CharType 0 "TV-Look" "TV-Look" 1
call Scene.SetDefSounds "Betty" $CharType
call SAct.SetCls "DefAction" "TV-Relax"
let CharType "Dtritus"
call Scene.AddCharActor "Dtritus" $CharType
call MakeChar.CreateRelaxAction $CharType 0 "Turn" "Turn" 1
call MakeChar.CreateRelaxAction $CharType 0 "Talk3" "Talk3" 1
call Scene.CreateLocalAction $CharType 0 "Listen" "Listen" 1
call Scene.SetDefSounds "Dtritus" $CharType
call SAct.SetCls "DefAction" "Relax"
let CharType "Humphrey"
call Scene.AddCharActor "Humphrey" $CharType
call MakeChar.CreateRelaxAction $CharType 0 "Turn" "Turn" 1
call MakeChar.CreateRelaxAction $CharType 0 "Talk" "Talk" 1
call MakeChar.CreateRelaxAction $CharType 0 "Talk0" "Talk0" 1
call MakeChar.CreateRelaxAction $CharType 0 "Talk1" "Talk1" 1
call Scene.SetDefSounds "Humphrey" $CharType
call SAct.SetCls "DefAction" "Relax"
let CharType "Cabecera"
call Scene.AddLocalActor "Cabecera" $CharType
call Scene.CreateLocalAction $CharType 0 "Relax" "Relax" 1
call SAct.SetCls "DefAction" "Relax"
let CharType "Screenshot1"
call Scene.AddLocalActor "Screenshot1" $CharType
call Scene.CreateLocalAction $CharType 0 "Relax" "Relax" 1
call SAct.SetCls "DefAction" "Relax"
let CharType "Final"
call Scene.AddLocalActor "Final" $CharType
call Scene.CreateLocalAction $CharType 0 "Relax" "Relax" 1
call SAct.SetCls "DefAction" "Relax"
let CharType "Portatil"
call Scene.AddLocalActor "Portatil" $CharType
call Scene.CreateLocalAction $CharType 0 "Relax" "Relax" 1
call SAct.SetCls "DefAction" "Relax"
run setdef "DefInterpTime"
run setdef "DefInterpTime"
