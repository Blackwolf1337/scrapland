# The functions of Mission_BankersCombat in level qf (the script levels/qf/scripts/mission_bankerscombat.py of data03.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: SetVars, CreatePlans, TakePlanPhoto, OnEndOfSuperCrazyDeal, BankersAttackPlayer, SetNextMission.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/qf/mission_bankerscombat.def replaces this file.
section InitStatus LevelPath
call Mission_BankersCombat.SetVars

section Init LevelPath
setvar TeamDeathMatch.KeepPlaying %Mission_BankersCombat.OnEndOfSuperCrazyDeal
call Scrap.Preload3DObject "Models/Misc/Blueprint/PlanoMBanker1.m3d"
call Scrap.Preload3DObject "Models/Misc/Blueprint/PlanoSBanker1.m3d"

section AllBankersAgainstPlayer
call Mission_BankersCombat.BankersAttackPlayer
call Speech.AddRemoteCom "Mission_GetBankerShipPlans_RemoteMessage7" "BankDirector"

section SetNextMission2
call SaveGame.QWayPoint
call MissionsFuncs.SetNextMission "Mission_PressMeeting" "Press"
call Scrap.Set "PlayVideo" "Video/Police.avi"
call Scrap.Achievement 3
call SaveGame.QLoad "Levels/Press"
