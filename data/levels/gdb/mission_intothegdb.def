# The functions of Mission_IntoTheGDB in level gdb (the script levels/gdb/scripts/mission_intothegdb.py of data03.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: GetBishopProfile, Init, CreateBishop, CreateBishops, InitMission, ScanShip, CheckContinueScanning, ResetScan, OnFinishScan, OnBishopsDeath, OnBishopsDamage, DropMatrix, ActivateMatrix, TakeMatrix, RestoreMatrix, LaunchRestoreMatrixAnim, RelaxBishops, MissionScorer.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/gdb/mission_intothegdb.def replaces this file.
section InitStatus LevelPath
setvar Map.CreateBishops 0

section StopMission
setvar Menu.MissionScorerCall None
call Scrap.DeleteScheduledFuncs "ScanShip"

section ResetScan2
call SScorer.Set 0 "ScanRemainingTime" "Blink" 0
call SScorer.Set 0 "ScanRemainingTime" "IsAutoUpdatable" 1
call SScorer.Set 0 "ScanRemainingTime" "MaxValue" %Mission_IntoTheGDB.MAX_SCANNING_TIME
call SScorer.Set 0 "ScanRemainingTime" "Value" %Mission_IntoTheGDB.MAX_SCANNING_TIME

section ReinsertMatrix matrixArrowName
setvar Parking.SwitchVehicleMissionCallback None
setvar Parking.SwitchCharMissionCallback None
call Mission_IntoTheGDB.ActivateMatrix $matrixArrowName
call SaveGame.MMDesc "Mission_ReInsertGusMatrix_MissionText1" 1
call SaveGame.QWayPoint

section PreSetNextMission
call Speech.AddRemoteCom "Mission_ReInsertGusMatrix_RemoteMessage1" "DeepThroat" %Mission_IntoTheGDB.SetNextMission

section SetNextMission
call Scrap.DelSaveVars "MissionState"
call MissionsFuncs.SetNextMission "Mission_AskGus" "Temple"
call SaveGame.MMDesc "Mission_AskGus_MissionText1" 1
call SaveGame.QWayPoint
