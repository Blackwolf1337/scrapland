# The functions of Map in level gdb (the script levels/gdb/scripts/map.py of data03.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script are C (src/game/Script/levels/GDB.c): Init, InitPoliceBishops, EndOfAppears, GiveLife, NextWave.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/gdb/map.def replaces this file.
section InitStatus LevelPath
setvar Init.Outdoor 1
setvar OutPolice.PoliceActive 0
call Scrap.Set "iTrafficNumber" 0
call Scrap.SetSaveVar "Char" "Bishop"
call Elevator.SetDef "TempleTeleporter" "DM_Door_TempleTeleporter_Temple"
