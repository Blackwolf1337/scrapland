# The functions of MapSnd in level ab (the script levels/ab/scripts/mapsnd.py of data03.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script are C (src/game/Script/levels/AB.c).
# Made by a converter from the script. A pack in mods/ with scrapc/levels/ab/mapsnd.def replaces this file.
section LoadSounds

section SetSounds

section Init LevelPath
call Scrap.OpenPack "$(LevelPath)/Sounds"
call MapSnd.LoadSounds
call Scrap.ClosePack
call MapSnd.SetSounds
