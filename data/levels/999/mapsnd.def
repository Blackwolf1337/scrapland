# The functions of MapSnd in level 999 (the script levels/999/scripts/mapsnd.py of Data.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/999/mapsnd.def replaces this file.
section LoadSounds

section SetSounds

section Init LevelPath
call Scrap.OpenPack "$(LevelPath)/Sounds"
call MapSnd.LoadSounds
call Scrap.ClosePack
call MapSnd.SetSounds
