# The functions of MapSnd in level scrapyard (the script levels/scrapyard/scripts/mapsnd.py of data02.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/scrapyard/mapsnd.def replaces this file.
section LoadSounds
call SSound.LoadSound "tunel334-scrap.wav"
if %MapSnd.isPC
	call SSound.LoadSound "maquina-scrap.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "aire-scrap.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "tube1-scrap.wav"
end
if %MapSnd.isPC
	call SSound.LoadSound "horno-scrap.wav"
end

