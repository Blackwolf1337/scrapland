section PlayFake0 usr=None
call Scene.Play "Fake0"
setvar Scene.EndOfSceneCallback %Map.PlayFake1
call SSound.SetMusic "Music/Track1.ogg" 1.0

section PlayFake1 usr=None
call Scene.Play "Fake1"
setvar Scene.EndOfSceneCallback %Map.PlayFake2

section LoadFake0Scene
call Scene.Load "Fake0"
call Scene.AddGeneric 25 "import CreditsText;CreditsText.ShowCredit(12)"
call Scene.ActorAction 0 "Dtritus" "Landing"
call Scene.ActorAction 260 "Dtritus" "Walk"
call Scene.ActorAction 0 "Berto" "Cartel"
call Scene.ActorAction 0 "Functionary" "Relax"
call Scene.ActorAction 260 "Functionary" "Walk"
call Scene.ActorAction 0 "Cartel" "Loop" "Loop"
call Scrap.Set "DefInterpTime" 1.0
let CharType "Dtritus"
call Scene.AddCharActor "Dtritus" $CharType
call MakeChar.CreateRelaxAction $CharType 0 "Walk" "Walk" 1
call Scene.CreateLocalAction $CharType 0 "Landing" "Landing" 0
call SAct.SetAct "InterpTime" 0.0
call Scene.SetDefSounds "Dtritus" $CharType
call SAct.SetCls "DefAction" "Relax"
let CharType "Berto"
call Scene.AddCharActor "Berto" $CharType
call Scene.CreateLocalAction $CharType 0 "Cartel" "Cartel" 1
call Scene.SetDefSounds "Berto" $CharType
call SAct.SetCls "DefAction" "Relax"
let CharType "Functionary"
call Scene.AddCharActor "Functionary" $CharType
call MakeChar.CreateRelaxAction $CharType 0 "Walk" "Walk" 1
call Scene.SetDefSounds "Functionary" $CharType
call SAct.SetCls "DefAction" "Walk"
let CharType "Cartel"
call Scene.AddLocalActor "Cartel" $CharType
call Scene.CreateLocalAction $CharType 0 "Loop" "Loop" 1
call SAct.SetCls "DefAction" "Loop"
run setdef "DefInterpTime"

section SetMotionBlur active
if $active
	call Scrap.Set "MotionBlurFactorBegin" 0.0
	call Scrap.Set "MotionBlurFactorEnd" 0.55
	call Scrap.Set "MotionBlurTime" 0.0
	call Scrap.Set "MotionBlurEndTime" 0.25
	call Scrap.Set "MotionBlurOffVar" 0
else
	call Scrap.Set "MotionBlurFactorBegin" 0.55
	call Scrap.Set "MotionBlurFactorEnd" 0.0
	call Scrap.Set "MotionBlurTime" 0.0
	call Scrap.Set "MotionBlurEndTime" 1.75
	call Scrap.Set "MotionBlurOffVar" 0
end

