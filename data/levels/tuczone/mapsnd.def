# The functions of MapSnd in level tuczone (the script levels/tuczone/scripts/mapsnd.py of data02.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/tuczone/mapsnd.def replaces this file.
section LoadSounds

section SetSounds

section Init LevelPath
call Scrap.OpenPack "$(LevelPath)/Sounds"
call MapSnd.LoadSounds
call Scrap.ClosePack
call MapSnd.SetSounds
