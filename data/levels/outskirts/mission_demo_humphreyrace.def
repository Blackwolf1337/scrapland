# The functions of Mission_Demo_HumphreyRace in level outskirts (the script levels/outskirts/scripts/mission_demo_humphreyrace.py of data01.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script are C (src/game/Script/levels/Outskirts.c): InitStatus, ShowSystemMessage, Init, ShowBoostMessage, ClosePressHangar, DelRacers, OnPlayerWinsRace, CallCrazyGambler, ShowRustyMapsSystemMessage, UsePhoneCab, EnableMetro, OnMetroUsed.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/outskirts/mission_demo_humphreyrace.def replaces this file.
section OnMetroUsedToPress UsrName MetroName optId FullOption
call Elevator.UseElevator $UsrName $MetroName "MoveLevel Press" $FullOption
call Metro.SetUsrParams $UsrName

section OnTryingToExit UsrName MetroName optId FullOption
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage12" "Humphrey"

section SetMissionTarget name
call MissionsFuncs.SetMissionTarget $name

section OnPlayerLoosesRace
call MissionsFuncs.SetMissionTarget None
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage6" "CrazyGambler"

section RustyAppears
call Scrap.IncSaveVar "NewBluePrintAvaliable" 2
call Speech.AddRemoteCom "Mission_FirstCrazyBet_RemoteMessage9" "Rusty" %Mission_Demo_HumphreyRace.ShowRustyMapsSystemMessage
call SaveGame.QWayPoint

section BossAppears
setvar Speech.OnOutOfRange None
call Speech.ForceRemoteCom "Mission_FirstCrazyBet_RemoteMessage11" "Boss" AfterRemoteComFunc=%Mission_Demo_HumphreyRace.EnableMetro Parameters=()

section OnEndOfDemo EntityName EventName Time
call Scrap.Set "PlayVideo" "Video/Yacuzzi.avi|Video/Bishop.avi"
call Scrap.DelSaveVars ""
call SaveGame.QLoad "Levels/Menu"
