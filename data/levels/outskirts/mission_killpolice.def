# The functions of Mission_KillPolice in level outskirts (the script levels/outskirts/scripts/mission_killpolice.py of data01.packed) that are data: one section
# per function, its parameters after the name. The other functions of the script stay Python: InitStatus, Init, InitMission, OnAlarm, OnPoliceDeath, BertoAppears, EnableMetro.
# Made by a converter from the script. A pack in mods/ with scrapc/levels/outskirts/mission_killpolice.def replaces this file.
section SetPos e pos
object $e
Pos $pos

section OnMainCharDeath MainCharnName Param2
call Scrap.SetSaveVar "PlayerHasBeenKilled" "1"
call MissionsFuncs.FinishGame 0

section ShowMessage2
call Speech.RemoteComunication "Mission_DestroyPolice_RemoteMessage2" "CrazyGambler"

section BertoAppears2
call Speech.AddRemoteCom "Mission_DestroyPolice_RemoteMessage6" "Berto" %Mission_KillPolice.EnableMetro ()

section OnMetroUsed UsrName MetroName optId FullOption
call Scrap.DelSaveVars "MissionState"
call Scrap.DelSaveVars "PlayerHasBeenKilled"
call Scrap.SetAlarm 0
call MissionsFuncs.SetNextMission "Mission_MeetBoss" "Press"
call Elevator.UseElevator $UsrName $MetroName "MoveLevel Press" $FullOption
call Metro.SetUsrParams $UsrName
