section BeatingDtritus
let CharName "BeatingDtritus"
let ActName "RelaxAstonished"
call Chars.ActSound $CharName $ActName 6 "mecanismo-dtritus3" 0.021
call Chars.ActSound $CharName $ActName 42 "mecanismo-dtritus4" 0.021
let ActName "RelaxDownLeft"
call Chars.ActSound $CharName $ActName 10 "mecanismo-dtritus3" 0.021
