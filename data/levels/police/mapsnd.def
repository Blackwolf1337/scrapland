section Beating
let SceneName "Beating"
call SSound.LoadSound "Beating/golpe-mano2.wav"
call SSound.LoadSound "Beating/golpe-mano-poker.wav"
call SSound.LoadSound "Beating/punch11.wav"
call SSound.LoadSound "Beating/FXRustyChispasSound.wav"
call Scene.AddSound 1250 "FXRustyChispasSound" 0.1 0 0
