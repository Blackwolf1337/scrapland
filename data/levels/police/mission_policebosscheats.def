section InitBossCheats
call Scrap.SetSaveVar "Mission_PoliceBossCheats" "BossCheats"
call SaveGame.QWayPoint
call MissionsFuncs.SetMissionTarget "DM_Mission_PoliceBoss_BossCheater"
call SaveGame.MMDesc "Mission_PhotoPoliceBoss_MissionText1" 1
call Mission_PoliceBossCheats.PlayDumb1

