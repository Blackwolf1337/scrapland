# Made by a converter from the script. A pack in mods/ with scrapc/levels/police/mission_getauthorization.def replaces this file.
section GetAuthorization2
call Scrap.Set "MessengerDataPackMissionArrow" 1
call Scrap.Set "MessengerTakenCallback" "Mission_GetAuthorization.OnDataTaken"
call Scrap.Set "MessengerDropCallback" "Mission_GetAuthorization.OnDataDropped"

section PreFreeHuman
call Scrap.Set "MessengerDataPackMissionArrow" 2
call Scrap.Set "MessengerTakenCallback" ""
call Scrap.Set "MessengerDropCallback" ""
call Scrap.SetSaveVar "MissionState" "FreeHuman"
call SaveGame.MMDesc "Mission_FirstMeetHuman_MissionText1" 1
call SaveGame.QWayPoint
call Mission_GetAuthorization.FreeHuman

section OnMainCharDeath MainCharnName Param2
call Scrap.SetAlarm 0
call Scrap.Set "AlarmFallDelta" %Mission_GetAuthorization.alarmFallDelta
call MissionsFuncs.FinishGame 0

section LoadScene
call Scene.Load "MeetHuman"
call Scene.ActorAction 0 "Dtritus" "Walk"
