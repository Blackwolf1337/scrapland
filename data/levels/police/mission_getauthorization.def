call Scene.ActorAction 980 "Human" "Talk"
call Scene.ActorAction 1019 "Human" "Relax"
call Scene.ActorAction 1190 "Human" "Sad"
call Scene.AddGeneric 1250 "SScorer.Fade(0,(0,0,0,0),(0,0,0,255),1.5)"
call Scene.AddText 490 "Mission_Scene_FirstMeetHuman_1" 3
