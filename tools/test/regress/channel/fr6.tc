# helpers/fr6.py as channel statements (round 6a: Bank, Police, Townhall level scripts), loaded after fsd.tc and
# again after every level load
import Scrap, sys
_R6HOOKS = (('Speech', 'OnEndOfSpeech'), ('Speech', 'OnEndOfSpeechParams'), ('Speech', 'PlayerName'), ('Speech', 'NPCName'),
	('CharAct', 'TakenPhoto'), ('CharAct', 'TakenPhotoMap'), ('CharAct', 'onNPCDeath'), ('CharConversor', 'OnPossession'),
	('CharConversor', 'afterExitConversor'), ('Alarm', 'RestoreMissionCallback'), ('Alarm', 'AbortMissionCallback'),
	('DTritusDesktop', 'DialogController'), ('Menu', 'MissionScorerCall'), ('GateKeeper', 'AfterGateKeeperSpeech'),
	('Elevator', 'OnElevatorReachUp'), ('Scene', 'EndOfSceneCallback'), ('Chars', 'OnMainCharDeath'),
	('MissionsFuncs', 'currentTarget'), ('MissionsFuncs', 'targetsList'), ('Messenger', 'MakeMDP'), ('Init', 'Outdoor'),
	('Init', 'OutArea'), ('CharsNPC', 'AfterBrowseNPC'), ('CharsNPC', 'RespawnChars'), ('CharsNPC', 'ReposChars'),
	('CharConversor', 'AvailableChars'), ('InTraffic', 'N_TrafficList'), ('InTraffic', 'N_NumTraffic'),
	('InTraffic', 'M_TrafficList'), ('InTraffic', 'M_NumTraffic'), ('InTraffic', 'H_TrafficList'), ('InTraffic', 'H_NumTraffic'))
# (module, variable, value) of module variables, '-' for a module that is not loaded
_tchooks = lambda pairs: map(lambda p: (p[0], p[1], _sdn(getattr(sys.modules[p[0]], p[1], '-')))
	if sys.modules.has_key(p[0]) else (p[0], p[1], '-'), pairs)
_r6hooks = lambda: _tchooks(_R6HOOKS)
_r6res = lambda: (map(__import__, ('CharsNPC',)), (lambda r: map(lambda k: (k, r[k].ActCtrl, _sdn(getattr(r[k], 'CallbackFunc', '-')),
	_sdn(getattr(r[k], 'Pos', '-'))), tc_sorted(r.keys())))(CharsNPC.CharRes))[1]
_r6sv = lambda names: map(lambda n: (n, Scrap.GetSaveVar(n)), names)
_r6gv = lambda names: map(lambda n: (n, tc_try(Scrap.Get, (n,), '?')), names)
_R6EV = ('ActCtrl', 'UseFunc', 'Descriptor', 'LLogicDefaultState', 'LLogicDefaultTarget', 'LLogicState', 'LLogicTarget',
	'LLogicProbTalkWhenWalking', 'LLogicEscapeWithinRadius', 'ArrowCanUse', 'ArrowCanMission', 'RadarShow', 'Money',
	'MoneyReward', 'Action', 'OnTake', 'Radius', 'OnlyUser', 'rTime', 'Blink', 'Active', 'Invulnerable', 'ArrOpt0')
_r6ent = lambda names, vs=_R6EV: _sdent(names, vs)
# the functions of a module: C (builtin) or Python
_tcfn = lambda m: (lambda d: map(lambda n: (n, 'C' if type(d[n]) == type(len) else 'py'),
	filter(lambda n: type(d[n]) == type(len) or type(d[n]).__name__ == 'function', tc_sorted(d.keys()))))(sys.modules[m].__dict__)
_r6fn = _tcfn
_r6on = lambda: (map(__import__, ('Speech', 'SaveGame', 'RaceMaker', 'CharsNPC', 'Scene', 'Menu', 'MissionsFuncs', 'Elevator', 'CharConversor')), (map(lambda n: setattr(Speech, n, _sdrec(n)), ('AddRemoteCom', 'OnSpch', 'NISpeech', 'AutoAddNI', 'AddNI',
		'RunNI', 'StdAnsLst', 'RestoreState', 'OnObjSpch', 'AutoSpeech', 'ForceRemoteCom')),
	setattr(Speech, 'RemoteComunication', _sdrec('RemoteComunication', 1)),
	setattr(Speech, 'SpeechRoutines', {'Police': _sdrec('Routine.Police'), 'PoliceBoss': _sdrec('Routine.PoliceBoss')}),
	map(lambda n: setattr(SaveGame, n, _sdrec(n)), ('QLoad', 'StartGame', 'MarkWayPoint', 'QWayPoint', 'MMDesc', 'SaveMoney',
		'CheckAllBlueprints')),
	setattr(RaceMaker, 'ShowSystemMessage', _sdrec('ShowSystemMessage')),
	setattr(CharsNPC, 'GenericNPCSpeech', _sdrec('GenericNPCSpeech')),
	setattr(Scene, 'Play', _sdrec('Scene.Play')),
	setattr(Menu, 'ShowWarning', _sdrec('ShowWarning')),
	setattr(Elevator, 'UseElevator', _sdrec('UseElevator')),
	setattr(CharConversor, 'ConvertChar', _sdrec('ConvertChar')),
	setattr(MissionsFuncs, 'FinishGame', _sdrec('FinishGame')), 1)[-1])[1]
# Scrap.CreateEntity recorded; the entity is made under a new name R6_<n>_<name>
_r6ce = lambda real: (lambda c: tc_obj(__name__ + '._r6ce', {'n': 0, 'real': real},
	lambda *a: (_sdr.append(('CreateEntity',) + _sdn(a)), tc_set(c, 0, c[0] + 1),
		apply(real, ('R6_' + `c[0]` + '_' + a[0],) + a[1:]))[2]))([0])
_r6realce = __globals__.get('_r6realce', Scrap.CreateEntity)
_r6ceon = lambda: (setattr(Scrap, 'CreateEntity', _r6ce(_r6realce)), 1)[1]
_r6ceoff = lambda: (setattr(Scrap, 'CreateEntity', _r6realce), 1)[1]
_r6items = lambda id, names, attrs: map(lambda n: tuple([n] + map(lambda a: tc_try(SScorer.Get, (id, n, a), '?'), attrs)), names)
