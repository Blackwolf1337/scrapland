# helpers/fpk.py as channel statements (Parking, ShipMaker, Sputnik and GateKeeper cases)
import Scrap, SAct
include fsnd
include fweap
_SHIPV = ('Model', 'MPil0', 'ActCtrl', 'Mass', 'Style', 'Engine', 'MinLife', 'MaxLife', 'BoostTime', 'VerticalBalance',
	'MEng0', 'MEng1', 'MEng2', 'MEng3', 'NEng0', 'NEng1', 'NEng2', 'NEng3', 'EngAnmF0', 'EngAnmF1', 'EngAnmF2', 'EngAnmF3',
	'EngAnmM0', 'EngAnmM1', 'EngAnmM2', 'EngAnmM3', 'EngFxClass0', 'EngFxClass1', 'EngFxClass2', 'EngFxClass3', 'WeapList')
_PARKV = ('ArrowCanUse', 'ArrnOpt', 'ArrOpt0', 'UseFunc', 'UsrControl', 'TgType', 'EntityList', 'OnDeath', 'Life', 'Active',
	'ActiveCMask', 'MoveTime', 'WRadius', 'VRadius', 'Descriptor', 'isWpn02', 'isWpn03', 'isWpn04', 'isWpn05')
_rnd = lambda x: round(x, 3) if type(x) == type(0.0) else (tuple(map(_rnd, x)) if type(x) == type(()) else x)
_v = lambda n, vs=None: (lambda vs, e: [n] + map(lambda v: tc_try(lambda: (v, _rnd(getattr(e, v))), (), (v, '?')), vs)
	if e else (n, None))(vs or _SHIPV, Scrap.GetEntity(n))
# every ship of the level, one entry per model and variables (the traffic and the parked ships pick models at random)
_ships = lambda vs=None: (lambda d: (map(lambda x: tc_set(d, `_v(x, vs)[1:]`, 1), _vehs()), tc_sorted(d.keys()))[1])({})
_tcname = lambda e: e and e != '?' and e.Name or e
_pk = lambda: (lambda P: map(lambda v: (v, tc_try(_tcname, (getattr(P, v, '?'),), 'deleted')),
	('PlayerShip', 'DtritusPlate', 'LastCamera', 'LastPark')) + map(lambda v: (v, getattr(P, v, '?')), ('SetWeaponOnShip',
	'AllShips', 'ShipTypes', 'ParkingZones', 'LastParkingZone', 'SwitchCharMissionCallback', 'SwitchVehicleMissionCallback',
	'ParkedOutCallback', 'OnCreatePlayerShip')) + [tc_try(lambda: ('LocalShip', P.__dict__.has_key('LocalShip') and P.LocalShip.Name),
	(), ('LocalShip', 'deleted'))])(__import__('Parking'))
_spt = lambda: (lambda S: map(lambda v: (v, _tcname(getattr(S, v, '?'))), ('spt', 'ply'))
	+ map(lambda v: (v, _rnd(getattr(S, v, '?'))), ('LastPos', 'LastAng', 'LastHangar', 'UseParams'))
	+ (S.spt and [_v(S.spt.Name, ('Pos', 'Ang', 'Action', 'Active', 'ActiveCMask', 'ArrowCanUse', 'ArrnOpt', 'ArrOpt0', 'UseFunc',
	'MoveTime'))] or []))(__import__('Sputnik'))
_cam = lambda: (lambda c: [Scrap.GetCam(0)] + map(lambda v: tc_try(lambda: (v, _rnd(getattr(c, v))), (), (v, '?')), ('Target',
	'MainTarget', 'EntityLink', 'CamDist', 'nWayPoint', 'OnEnd', 'TgtCam00', 'TgtCam01', 'TgtCam03', 'Time00', 'FadeIn00',
	'FadeOut00', 'Pos00', 'Ang00', 'Pos01', 'Ang01', 'FOV01', 'Pos02', 'Ang02')))(Scrap.GetEntity(Scrap.GetCam(0)))
_usr = lambda: (lambda u: u and _v(u.Name, ('ActCtrl', 'Model', 'MPil0', 'UsrControl', 'Active', 'TgType', 'EntityList', 'OnDeath',
	'AcWeap', 'Descriptor', 'Pos')))(Scrap.UsrEntity(0))
# a function that stops the game clock (Menu.InitMenuSys(0)), with the clock running again after it
_wrapT = lambda f: tc_obj(__name__ + '._wrapT', {'f': f}, lambda *a: tc_finally(f, a, lambda: Scrap.SetTimeSpeed(1)))
# a ship with the standard parts of key (Vehicles.SetStdProperties, which calls ShipMaker.SetShipParams)
_std = lambda key, name: (map(__import__, ('Vehicles',)), (lambda v: (Vehicles.SetStdProperties(v.Name, key, 'P_Police'), _v(v.Name, _SHIPV + ('AnmP0',)))[1])(
	Scrap.GetEntity(name) or (lambda p: Scrap.CreateEntity(name, p[0] + 3000.0, p[1] + 3000.0, p[2], 'Car'))(Scrap.UsrEntity(0).Pos)))[1]
# the items of the level by name (fweap replaces _items)
_its = lambda: (lambda n: (setattr(__import__('Init'), '_itemcollect', lambda x: n.append(x)),
	Scrap.SphereCall(0.0, 0.0, 0.0, 300000.0, 'i', 'Init._itemcollect'), n.sort(), n)[3])([])
