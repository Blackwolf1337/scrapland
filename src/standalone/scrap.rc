/*
 * The resources of ScrapC.exe: the icons and the manifest of Scrap.exe 1.6.1 (the icon images get the ids 1, 2 ...
 * in the order of the ICON lines, as in the original). The menus, dialogs, accelerators and the bitmap of the
 * original went with the Win32 window code (SDL3 platform layer).
 */
#include <windows.h>

#pragma code_page(65001)

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

101 ICON "res/icon101.ico"

106 ICON "res/icon106.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 RT_MANIFEST "res/manifest1.xml"
