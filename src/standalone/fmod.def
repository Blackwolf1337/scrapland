; The import library of fmod.dll for ScrapC.exe (docs/standalone.md, stage 3c1a): the functions Scrap.exe 1.6.1
; imports from it. fmod.dll exports the stdcall names with their underscore (_FSOUND_Init@12), which is the C symbol
; too. CMakeLists.txt makes libfmod.a from this file with dlltool.
LIBRARY "fmod.dll"
EXPORTS
FSOUND_Close@0 == _FSOUND_Close@0
FSOUND_GetCPUUsage@0 == _FSOUND_GetCPUUsage@0
FSOUND_GetChannelsPlaying@0 == _FSOUND_GetChannelsPlaying@0
FSOUND_GetCurrentSample@4 == _FSOUND_GetCurrentSample@4
FSOUND_GetDriverCaps@8 == _FSOUND_GetDriverCaps@8
FSOUND_GetDriverName@4 == _FSOUND_GetDriverName@4
FSOUND_GetError@0 == _FSOUND_GetError@0
FSOUND_GetFrequency@4 == _FSOUND_GetFrequency@4
FSOUND_GetLoopMode@4 == _FSOUND_GetLoopMode@4
FSOUND_GetMaxChannels@0 == _FSOUND_GetMaxChannels@0
FSOUND_GetMemoryStats@8 == _FSOUND_GetMemoryStats@8
FSOUND_GetMixer@0 == _FSOUND_GetMixer@0
FSOUND_GetNumDrivers@0 == _FSOUND_GetNumDrivers@0
FSOUND_GetNumHWChannels@12 == _FSOUND_GetNumHWChannels@12
FSOUND_GetNumSubChannels@4 == _FSOUND_GetNumSubChannels@4
FSOUND_GetOutput@0 == _FSOUND_GetOutput@0
FSOUND_GetPan@4 == _FSOUND_GetPan@4
FSOUND_GetPriority@4 == _FSOUND_GetPriority@4
FSOUND_GetReserved@4 == _FSOUND_GetReserved@4
FSOUND_GetSFXMasterVolume@0 == _FSOUND_GetSFXMasterVolume@0
FSOUND_GetVersion@0 == _FSOUND_GetVersion@0
FSOUND_GetVolume@4 == _FSOUND_GetVolume@4
FSOUND_Init@12 == _FSOUND_Init@12
FSOUND_IsPlaying@4 == _FSOUND_IsPlaying@4
FSOUND_PlaySoundEx@16 == _FSOUND_PlaySoundEx@16
FSOUND_Sample_Free@4 == _FSOUND_Sample_Free@4
FSOUND_Sample_GetDefaults@20 == _FSOUND_Sample_GetDefaults@20
FSOUND_Sample_GetMode@4 == _FSOUND_Sample_GetMode@4
FSOUND_Sample_GetName@4 == _FSOUND_Sample_GetName@4
FSOUND_Sample_Load@20 == _FSOUND_Sample_Load@20
FSOUND_SetDriver@4 == _FSOUND_SetDriver@4
FSOUND_SetFrequency@8 == _FSOUND_SetFrequency@8
FSOUND_SetLoopMode@8 == _FSOUND_SetLoopMode@8
FSOUND_SetOutput@4 == _FSOUND_SetOutput@4
FSOUND_SetPan@8 == _FSOUND_SetPan@8
FSOUND_SetPaused@8 == _FSOUND_SetPaused@8
FSOUND_SetReserved@8 == _FSOUND_SetReserved@8
FSOUND_SetVolume@8 == _FSOUND_SetVolume@8
FSOUND_StopSound@4 == _FSOUND_StopSound@4
FSOUND_Stream_Close@4 == _FSOUND_Stream_Close@4
FSOUND_Stream_Create@20 == _FSOUND_Stream_Create@20
FSOUND_Stream_GetLengthMs@4 == _FSOUND_Stream_GetLengthMs@4
FSOUND_Stream_GetOpenState@4 == _FSOUND_Stream_GetOpenState@4
FSOUND_Stream_GetSample@4 == _FSOUND_Stream_GetSample@4
FSOUND_Stream_GetTime@4 == _FSOUND_Stream_GetTime@4
FSOUND_Stream_Open@16 == _FSOUND_Stream_Open@16
FSOUND_Stream_Play@8 == _FSOUND_Stream_Play@8
FSOUND_Stream_PlayEx@16 == _FSOUND_Stream_PlayEx@16
FSOUND_Stream_SetBufferSize@4 == _FSOUND_Stream_SetBufferSize@4
FSOUND_Stream_Stop@4 == _FSOUND_Stream_Stop@4
