; The import library of Galaxy.dll for ScrapC.exe (docs/standalone.md, stage 3c1a): the functions Scrap.exe 1.6.1
; imports from it, the C++ names of galaxy::api (cdecl), whose symbols are __imp_<name> (GAME_IMPORT_SYM).
; CMakeLists.txt makes libgalaxy.a from this file with dlltool.
LIBRARY "Galaxy.dll"
EXPORTS
"?Apps@api@galaxy@@YAPAVIApps@12@XZ"
"?Friends@api@galaxy@@YAPAVIFriends@12@XZ"
"?Init@api@galaxy@@YAXABUInitOptions@12@@Z"
"?ListenerRegistrar@api@galaxy@@YAPAVIListenerRegistrar@12@XZ"
"?Logger@api@galaxy@@YAPAVILogger@12@XZ"
"?ProcessData@api@galaxy@@YAXXZ"
"?Stats@api@galaxy@@YAPAVIStats@12@XZ"
"?User@api@galaxy@@YAPAVIUser@12@XZ"
